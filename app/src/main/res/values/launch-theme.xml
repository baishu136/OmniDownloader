<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="omniLaunchIconColor" format="color" />
    <style name="Theme.OmniDownloader.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/omni_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.OmniDownloader.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/omni_window_background_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
