<Window
    x:Class="OmniDownloader.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:locui="using:OmniDownloader.WinUI.Helpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OmniDownloader">

    <Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义扩展标题栏：Win11 保留原生右留白，Win10 自动启用内置 Fluent 控制按钮消除顶边细线 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="14,0,148,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="TitleAppIcon" Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="TitleAppNameText" Grid.Column="1" Text="OmniDownloader" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" TextWrapping="NoWrap" MaxLines="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Border Grid.Column="2" x:Name="TitleBadge" Style="{StaticResource OmniTagBorderStyle}" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="WinUI 3" Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
            </Grid>

            <TextBlock
                x:Name="TitleStatusText"
                Grid.Column="1"
                Text="{x:Bind Vm.BackendStatusText, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
                MaxWidth="360"
                TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,4,0">
                <Ellipse
                    x:Name="TitleStatusDot"
                    Width="8"
                    Height="8"
                    Visibility="Collapsed"
                    Fill="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    ToolTipService.ToolTip="{x:Bind Vm.BackendStatusText, Mode=OneWay}" />
                <Button
                    Padding="7,3"
                    locui:Localized.ToolTip="重新连接本地核心引擎"
                    Click="ReconnectBtn_Click">
                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                </Button>
            </StackPanel>

            <!-- Windows 10 无边框模式专用标题栏控制按钮组（仅在 Win10 下显示） -->
            <StackPanel
                x:Name="Win10CaptionButtonsPanel"
                Grid.Column="3"
                Orientation="Horizontal"
                Visibility="Collapsed"
                VerticalAlignment="Stretch"
                Margin="6,0,0,0">
                <StackPanel.Resources>
                    <Style x:Key="Win10CaptionBtnStyle" TargetType="Button">
                        <Setter Property="Width" Value="46" />
                        <Setter Property="Height" Value="38" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                    </Style>
                </StackPanel.Resources>
                <Button
                    x:Name="Win10MinBtn"
                    Style="{StaticResource Win10CaptionBtnStyle}"
                    Click="Win10MinBtn_Click">
                    <FontIcon Glyph="&#xE921;" FontSize="10" />
                </Button>
                <Button
                    x:Name="Win10MaxBtn"
                    Style="{StaticResource Win10CaptionBtnStyle}"
                    Click="Win10MaxBtn_Click">
                    <FontIcon x:Name="Win10MaxGlyph" Glyph="&#xE922;" FontSize="10" />
                </Button>
                <Button
                    x:Name="Win10CloseBtn"
                    Style="{StaticResource Win10CaptionBtnStyle}"
                    Click="Win10CloseBtn_Click">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C42B1C" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B22417" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                    </Button.Resources>
                    <FontIcon Glyph="&#xE8BB;" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Windows 11 原生侧边导航架构 + 统一平滑选中指示滑块（覆盖 FooterMenuItems 与 MenuItems） -->
        <Grid Grid.Row="1">
            <NavigationView
                x:Name="MainNavView"
                Background="Transparent"
                PaneDisplayMode="Auto"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                OpenPaneLength="196"
                CompactModeThresholdWidth="680"
                ExpandedModeThresholdWidth="940"
                DisplayModeChanged="MainNavView_DisplayModeChanged"
                SelectionChanged="MainNavView_SelectionChanged"
                PaneOpened="MainNavView_PaneStateChanged"
                PaneClosed="MainNavView_PaneStateChanged">
                <NavigationView.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
                                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#16000000" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Default">
                                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
                                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FF24262D" />
                                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#20FFFFFF" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast">
                                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </NavigationView.Resources>

                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="NavHome" Content="{x:Bind Vm.Loc.NavHome, Mode=OneWay}" Tag="home" IsSelected="True">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavBatch" Content="{x:Bind Vm.Loc.NavBatch, Mode=OneWay}" Tag="batch">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8FD;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavTasks" Content="{x:Bind Vm.Loc.NavTasks, Mode=OneWay}" Tag="tasks">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE896;" />
                        </NavigationViewItem.Icon>
                        <NavigationViewItem.InfoBadge>
                            <InfoBadge
                                Value="{x:Bind Vm.ActiveTasksCount, Mode=OneWay}"
                                Visibility="{x:Bind Vm.ActiveTasksBadgeVisibility, Mode=OneWay}" />
                        </NavigationViewItem.InfoBadge>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavRules" Content="{x:Bind Vm.Loc.NavRules, Mode=OneWay}" Tag="rules">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE71C;" />
                        </NavigationViewItem.Icon>
                        <NavigationViewItem.InfoBadge>
                            <InfoBadge
                                Value="{x:Bind Vm.RulesVm.PendingConfirmCount, Mode=OneWay}"
                                Visibility="{x:Bind Vm.RulesVm.PendingConfirmBadgeVisibility, Mode=OneWay}" />
                        </NavigationViewItem.InfoBadge>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <NavigationView.FooterMenuItems>
                    <NavigationViewItem x:Name="NavHelp" Content="{x:Bind Vm.Loc.NavHelp, Mode=OneWay}" Tag="help" SelectsOnInvoked="False" Tapped="NavHelp_Tapped">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE897;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavSettings" Content="{x:Bind Vm.Loc.NavSettings, Mode=OneWay}" Tag="settings">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>

                <Grid>
                    <Frame x:Name="ContentFrame" />

                    <!-- 底部自适应全局 InfoBar 通知 -->
                    <InfoBar
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Margin="16,0,16,16"
                        MaxWidth="540"
                        IsOpen="{x:Bind Vm.IsNoticeOpen, Mode=TwoWay}"
                        Severity="{x:Bind Vm.NoticeSeverity, Mode=OneWay}"
                        Message="{x:Bind Vm.NoticeMessage, Mode=OneWay}" />
                </Grid>
            </NavigationView>

            <!-- 自定义统一导航选中指示器：跨 MenuItems 与 FooterMenuItems (设置) 均可稳定流畅滑动 -->
            <Canvas x:Name="NavIndicatorCanvas" IsHitTestVisible="False">
                <Border
                    x:Name="NavSelectionPill"
                    Width="3"
                    Height="16"
                    CornerRadius="1.5"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    RenderTransformOrigin="0.5,0.5"
                    Opacity="0">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="NavPillScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="NavPillTranslate" X="4" Y="0" />
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>
            </Canvas>
        </Grid>

        <!-- Windows 10 无边框模式八方向透明尺寸拖拽手柄 -->
        <Grid x:Name="Win10ResizeLayer" Grid.RowSpan="2" Visibility="Collapsed" />
    </Grid>
</Window>
