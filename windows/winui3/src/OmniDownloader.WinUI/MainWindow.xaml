<Window
    x:Class="OmniDownloader.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OmniDownloader">

    <Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义扩展标题栏：3 列响应式排布，窄窗口自动隐藏副文本防叠字 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="14,0,142,0" ColumnSpacing="8" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="OmniDownloader" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border x:Name="TitleBadge" Style="{StaticResource OmniTagBorderStyle}" VerticalAlignment="Center">
                    <TextBlock Text="WinUI 3" Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
            </StackPanel>

            <TextBlock
                x:Name="TitleStatusText"
                Grid.Column="1"
                Text="{x:Bind Vm.BackendStatusText, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse
                    x:Name="TitleStatusDot"
                    Width="8"
                    Height="8"
                    Visibility="Collapsed"
                    Fill="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    ToolTipService.ToolTip="{x:Bind Vm.BackendStatusText, Mode=OneWay}" />
                <Button
                    Padding="7,3"
                    ToolTipService.ToolTip="重新连接本地核心引擎"
                    Click="ReconnectBtn_Click">
                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Windows 11 原生侧边导航架构 -->
        <NavigationView
            x:Name="MainNavView"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="210"
            CompactModeThresholdWidth="680"
            ExpandedModeThresholdWidth="980"
            DisplayModeChanged="MainNavView_DisplayModeChanged"
            SelectionChanged="MainNavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavHome" Content="{x:Bind Vm.Loc.NavHome, Mode=OneWay}" Tag="home" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavBatch" Content="{x:Bind Vm.Loc.NavBatch, Mode=OneWay}" Tag="batch">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavTasks" Content="{x:Bind Vm.Loc.NavTasks, Mode=OneWay}" Tag="tasks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            Value="{x:Bind Vm.ActiveTasksCount, Mode=OneWay}"
                            Visibility="{x:Bind Vm.ActiveTasksBadgeVisibility, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavHelp" Content="{x:Bind Vm.Loc.NavHelp, Mode=OneWay}" Tag="help" SelectsOnInvoked="False" Tapped="NavHelp_Tapped">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE897;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSettings" Content="{x:Bind Vm.Loc.NavSettings, Mode=OneWay}" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Frame x:Name="ContentFrame" />

                <!-- 底部自适应全局 InfoBar 通知 -->
                <InfoBar
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Margin="16,0,16,16"
                    MaxWidth="540"
                    IsOpen="{x:Bind Vm.IsNoticeOpen, Mode=TwoWay}"
                    Severity="{x:Bind Vm.NoticeSeverity, Mode=OneWay}"
                    Message="{x:Bind Vm.NoticeMessage, Mode=OneWay}" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
