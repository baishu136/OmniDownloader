<Page
    x:Class="OmniDownloader.WinUI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OmniDownloader.WinUI.ViewModels"
    xmlns:models="using:OmniDownloader.WinUI.Core.Models"
    xmlns:controls="using:OmniDownloader.WinUI.Controls"
    SizeChanged="Page_SizeChanged"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="ContentContainer" MaxWidth="820" Margin="28,18,28,32">
            <StackPanel Spacing="18">
                <!-- 1. Hero 头部（支持平台清单统一集成在右上角支持平台目录弹窗内） -->
                <Grid RowSpacing="8" ColumnSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="HeroTitleText"
                            Text="OmniDownloader"
                            Style="{StaticResource TitleTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                        <Border Style="{StaticResource OmniTagBorderStyle}" VerticalAlignment="Center">
                            <TextBlock Text="v1.7.60" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                    </StackPanel>

                    <Button
                        x:Name="HeroCatalogBtn"
                        Grid.Row="0"
                        Grid.Column="1"
                        AutomationProperties.Name="支持平台目录"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="OpenPlatformCatalog_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE774;" FontSize="14" />
                            <TextBlock Text="支持平台目录" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 2. 核心链接输入与解析卡片 -->
                <Border Style="{StaticResource OmniCardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="UrlInputBox"
                                Grid.Column="0"
                                Text="{x:Bind Vm.InputUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{x:Bind Vm.Loc.HomePlaceholder, Mode=OneWay}"
                                KeyDown="UrlInputBox_KeyDown" />

                            <Button
                                Grid.Column="1"
                                ToolTipService.ToolTip="粘贴或清除"
                                Command="{x:Bind Vm.InlinePasteOrClearCommand}">
                                <FontIcon Glyph="{x:Bind InlineIconGlyph(Vm.HasInput), Mode=OneWay}" FontSize="15" />
                            </Button>
                        </Grid>

                        <!-- 双主按钮区（窄窗口自动转为上下两行全宽） -->
                        <Grid x:Name="ActionButtonsGrid" ColumnSpacing="10" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="PasteActionBtn"
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Padding="12,9"
                                Command="{x:Bind Vm.PasteAndAnalyzeCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE77F;" FontSize="15" />
                                    <TextBlock Text="{x:Bind Vm.Loc.BtnPasteAnalyze, Mode=OneWay}" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="AnalyzeActionBtn"
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Padding="12,9"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind CanClickAnalyze(Vm.HasInput, Vm.IsAnalyzing), Mode=OneWay}"
                                Command="{x:Bind Vm.AnalyzeOrCancelCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing
                                        Width="16"
                                        Height="16"
                                        IsActive="{x:Bind Vm.IsAnalyzing, Mode=OneWay}"
                                        Visibility="{x:Bind Vm.IsAnalyzing, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <FontIcon
                                        Glyph="&#xE945;"
                                        FontSize="15"
                                        Visibility="{x:Bind Vm.IsAnalyzing, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                    <TextBlock Text="{x:Bind AnalyzeButtonText(Vm.IsAnalyzing), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 浏览器辅助提取折叠区 -->
                        <Expander HorizontalAlignment="Stretch" Header="{x:Bind Vm.Loc.BrowserAssistTitle, Mode=OneWay}">
                            <StackPanel Spacing="8" Padding="0,6,0,2">
                                <TextBlock
                                    Text="针对需要网页验证或登录才能播放的内容（如小黑盒、抖音、快手），可在内置或辅助窗口验证播放后读取直链或图文。"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                                <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                    <Button Content="打开辅助浏览器" Command="{x:Bind Vm.OpenBrowserAssistCommand}" />
                                    <Button Content="读取已播放媒体" Command="{x:Bind Vm.CapturePlayedMediaCommand}" />
                                    <Button Content="提取已打开图文" Command="{x:Bind Vm.CaptureBrowserImagesCommand}" />
                                </controls:WrapPanel>
                            </StackPanel>
                        </Expander>

                        <!-- 中转站快捷行 -->
                        <StackPanel Visibility="{x:Bind Vm.HasRelaySites, Mode=OneWay, Converter={StaticResource BoolToVis}}" Spacing="6">
                            <Grid>
                                <TextBlock Text="第三方解析中转站点" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <HyperlinkButton Content="管理中转站" HorizontalAlignment="Right" Padding="4,0" Click="GoRelaySettings_Click" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind Vm.QuickRelaySites, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:RelaySite">
                                        <Button Tag="{x:Bind}" Click="QuickRelayBtn_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                                                <TextBlock Text="{x:Bind Name}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 3. 解析错误提示区 -->
                <InfoBar
                    IsOpen="{x:Bind Vm.HasAnalyzeError, Mode=TwoWay}"
                    Severity="Error"
                    Title="{x:Bind Vm.AnalyzeErrorTitle, Mode=OneWay}"
                    Message="{x:Bind Vm.AnalyzeErrorHint, Mode=OneWay}">
                    <InfoBar.Content>
                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" Margin="0,0,0,10">
                            <Button Content="重试" Command="{x:Bind Vm.AnalyzeOrCancelCommand}" />
                            <Button Content="查看详情" Command="{x:Bind Vm.ShowAnalyzeErrorDetailCommand}" />
                            <Button
                                Content="前往修复设置"
                                Command="{x:Bind Vm.GoErrorFixSettingsCommand}"
                                Visibility="{x:Bind IsActionableSettingsError(Vm.AnalyzeErrorAction), Mode=OneWay}" />
                        </controls:WrapPanel>
                    </InfoBar.Content>
                </InfoBar>

                <!-- 4. 已解析视频恢复栏（关闭画质窗后可一键重开） -->
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="16,12"
                    Visibility="{x:Bind Vm.HasVideoMetadata, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    Click="ResumeFormatDialog_Click">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8B2;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind Vm.CurrentVideoMetadata.Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="点击重新打开画质与下载配置窗口" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <!-- 5. 图文解析结果多选网格 -->
                <Border
                    Style="{StaticResource OmniCardBorderStyle}"
                    Visibility="{x:Bind Vm.HasImagePost, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Vm.CurrentImagePost.Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="WrapWholeWords" />
                            <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="4">
                                <TextBlock Text="{x:Bind Vm.ImageSelectionSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock
                                    Text="部分为平台可用清晰度资源"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="{x:Bind Vm.HasMixedImageSources, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </controls:WrapPanel>
                        </StackPanel>

                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                            <Button Content="全选" Command="{x:Bind Vm.SelectAllImagesCommand}" />
                            <Button Content="取消全选" Command="{x:Bind Vm.DeselectAllImagesCommand}" />
                            <Button
                                Content="导出 ZIP"
                                IsEnabled="{x:Bind HasSelectedImages(Vm.SelectedImagesCount), Mode=OneWay}"
                                Click="ExportImagesZip_Click" />
                            <Button
                                Content="保存选中原图"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind HasSelectedImages(Vm.SelectedImagesCount), Mode=OneWay}"
                                Click="SaveSelectedImages_Click" />
                        </controls:WrapPanel>

                        <ItemsRepeater ItemsSource="{x:Bind Vm.ImageItems, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="136" MinItemHeight="196" MinColumnSpacing="10" MinRowSpacing="10" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:SelectableImageItem">
                                    <Border
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="6">
                                        <Grid RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="142" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Button
                                                Grid.Row="0"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Tag="{x:Bind Index}"
                                                Click="ImagePreviewCard_Click">
                                                <Grid>
                                                    <FontIcon Glyph="&#xEB9F;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <Image Tag="{x:Bind AbsolutePreviewUrl}" Loaded="PreviewImage_Loaded" Stretch="UniformToFill" />
                                                </Grid>
                                            </Button>

                                            <CheckBox
                                                Grid.Row="1"
                                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                Content="{x:Bind Caption}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- 6. 最近 / 正在下载任务区块 -->
                <StackPanel
                    Spacing="10"
                    Visibility="{x:Bind Vm.HasRecentTasks, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Vm.RecentSectionHeading, Mode=OneWay}" Style="{StaticResource GroupHeaderTextStyle}" TextTrimming="CharacterEllipsis" />
                        <HyperlinkButton Grid.Column="1" Content="{x:Bind Vm.Loc.ViewAllLabel, Mode=OneWay}" HorizontalAlignment="Right" Padding="4,0" Click="GoAllTasks_Click" />
                    </Grid>

                    <ItemsRepeater ItemsSource="{x:Bind Vm.RecentTasks, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentTaskItem">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="12,10"
                                    Tag="{x:Bind}"
                                    Click="RecentTaskCard_Click">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="72" Height="46" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE8B2;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <Image Tag="{x:Bind ThumbnailUrl, Mode=OneWay}" Loaded="PreviewImage_Loaded" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="4">
                                                    <Border Style="{StaticResource OmniTagBorderStyle}">
                                                        <TextBlock Text="{x:Bind TypeBadge, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                    </Border>
                                                    <Border Style="{StaticResource OmniTagBorderStyle}">
                                                        <TextBlock Text="{x:Bind StatusBadge, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                    </Border>
                                                </controls:WrapPanel>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="4" Visibility="{x:Bind ShowProgress, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <ProgressBar Value="{x:Bind ProgressValue, Mode=OneWay}" Maximum="100" />
                                            <Grid>
                                                <TextBlock Text="{x:Bind ProgressSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind EtaSummary, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
