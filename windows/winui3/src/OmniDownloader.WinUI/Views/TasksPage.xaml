<Page
    x:Class="OmniDownloader.WinUI.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:locui="using:OmniDownloader.WinUI.Helpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OmniDownloader.WinUI.ViewModels"
    xmlns:controls="using:OmniDownloader.WinUI.Controls"
    SizeChanged="Page_SizeChanged"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="ContentContainer" MaxWidth="820" Margin="28,18,28,32">
            <StackPanel Spacing="16">
                <!-- 顶部标题与批量操作（支持窄窗口自动换行） -->
                <Grid RowSpacing="10" ColumnSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                        <TextBlock x:Name="PageTitleText" Text="{x:Bind Vm.Loc.TasksTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Vm.ActiveSubtitle, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <controls:WrapPanel
                        x:Name="HeaderActionsPanel"
                        Grid.Row="0"
                        Grid.Column="1"
                        HorizontalSpacing="8"
                        VerticalSpacing="8"
                        VerticalAlignment="Center">
                        <Button Command="{x:Bind Vm.OpenDownloadFolderCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock locui:Localized.Text="打开文件夹" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind Vm.ClearRecordsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock locui:Localized.Text="清空记录" />
                            </StackPanel>
                        </Button>
                    </controls:WrapPanel>
                </Grid>

                <!-- 3 段原生分段筛选器（窄屏支持压缩内边距与水平安全滚动，避免右侧标签裁切） -->
                <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <SelectorBar x:Name="TaskFilterBar" SelectionChanged="TaskFilterBar_SelectionChanged">
                        <SelectorBarItem x:Name="AllFilterItem" Text="{x:Bind Vm.AllTabText, Mode=OneWay}" Tag="all" IsSelected="True" />
                        <SelectorBarItem x:Name="ActiveFilterItem" Text="{x:Bind Vm.ActiveTabText, Mode=OneWay}" Tag="active" />
                        <SelectorBarItem x:Name="CompletedFilterItem" Text="{x:Bind Vm.CompletedTabText, Mode=OneWay}" Tag="completed" />
                    </SelectorBar>
                </ScrollViewer>

                <!-- 空状态 -->
                <Border
                    Style="{StaticResource OmniCardBorderStyle}"
                    Padding="28"
                    Visibility="{x:Bind Vm.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="34" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind Vm.EmptyTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>

                <!-- 任务与合集分组列表 -->
                <ItemsRepeater ItemsSource="{x:Bind Vm.VisibleEntries, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="10" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaskGroupViewModel">
                            <Border Style="{StaticResource OmniCardBorderStyle}">
                                <StackPanel Spacing="10">
                                    <!-- A. 单任务卡片内容 -->
                                    <StackPanel Spacing="10" Visibility="{x:Bind IsSingle, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="80" Height="52" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE8B2;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <Image locui:NativeShellHelper.BoundThumbnailUrl="{x:Bind ThumbnailUrl, Mode=OneWay}" locui:NativeShellHelper.BoundTaskId="{x:Bind Primary.Id, Mode=OneWay}" locui:NativeShellHelper.ThumbnailDecodeWidth="200" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="WrapWholeWords" />
                                                <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="4">
                                                    <Border Style="{StaticResource OmniTagBorderStyle}">
                                                        <TextBlock Text="{x:Bind TypeBadge, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource OmniTagBorderStyle}">
                                                        <TextBlock Text="{x:Bind StatusBadge, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind FileSizeText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                </controls:WrapPanel>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="4" Visibility="{x:Bind ShowProgressBar, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <ProgressBar Value="{x:Bind ProgressValue, Mode=OneWay}" Maximum="100" />
                                            <Grid>
                                                <TextBlock Text="{x:Bind ProgressSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind EtaSummary, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </StackPanel>

                                        <InfoBar
                                            Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                            IsOpen="{x:Bind HasError, Mode=OneWay}"
                                            IsClosable="False"
                                            Severity="Error"
                                            Message="{x:Bind ErrorText, Mode=OneWay}">
                                            <InfoBar.ActionButton>
                                                <Button locui:Localized.Content="查看详情" Tag="{x:Bind Primary, Mode=OneWay}" Click="ShowTaskErrorBtn_Click" />
                                            </InfoBar.ActionButton>
                                        </InfoBar>

                                        <!-- 卡片操作按钮改为自适应 WrapPanel，窄窗自动换行绝不溢出 -->
                                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                            <Button
                                                Style="{StaticResource AccentButtonStyle}"
                                                AutomationProperties.Name="{x:Bind PrimaryActionText, Mode=OneWay}"
                                                Visibility="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                Tag="{x:Bind Primary, Mode=OneWay}"
                                                Click="PlayTaskBtn_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="{x:Bind PrimaryActionGlyph, Mode=OneWay}" FontSize="13" />
                                                    <TextBlock Text="{x:Bind PrimaryActionText, Mode=OneWay}" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                locui:Localized.Content="在电脑中定位"
                                                Visibility="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                Tag="{x:Bind Primary, Mode=OneWay}"
                                                Click="LocateTaskBtn_Click" />
                                            <Button
                                                locui:Localized.Content="取消"
                                                Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                Tag="{x:Bind Primary, Mode=OneWay}"
                                                Click="CancelTaskBtn_Click" />
                                            <Button
                                                Style="{StaticResource AccentButtonStyle}"
                                                locui:Localized.Content="重试"
                                                Visibility="{x:Bind IsFailedOrCancelled, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                Tag="{x:Bind Primary, Mode=OneWay}"
                                                Click="RetryTaskBtn_Click" />
                                            <Button
                                                locui:Localized.ToolTip="删除"
                                                Tag="{x:Bind Primary, Mode=OneWay}"
                                                Click="DeleteSingleTaskBtn_Click">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                            </Button>
                                        </controls:WrapPanel>
                                    </StackPanel>

                                    <!-- B. 合集折叠分组卡片内容 -->
                                    <StackPanel Spacing="10" Visibility="{x:Bind IsCollection, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="80" Height="52" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE8FD;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <Image locui:NativeShellHelper.BoundThumbnailUrl="{x:Bind ThumbnailUrl, Mode=OneWay}" locui:NativeShellHelper.BoundTaskId="{x:Bind Primary.Id, Mode=OneWay}" locui:NativeShellHelper.ThumbnailDecodeWidth="200" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="WrapWholeWords" />
                                                <Border Style="{StaticResource OmniTagBorderStyle}" HorizontalAlignment="Left">
                                                    <TextBlock Text="{x:Bind CollectionBadge, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind CollectionProgressSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                                            <ProgressBar Value="{x:Bind CollectionProgressValue, Mode=OneWay}" Maximum="100" />
                                        </StackPanel>

                                        <StackPanel Spacing="8">
                                            <HyperlinkButton
                                                Content="{x:Bind CollectionExpandText, Mode=OneWay}"
                                                Padding="0"
                                                Tag="{x:Bind}"
                                                Click="ToggleCollectionBtn_Click" />

                                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                                <Button
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Content="{x:Bind CollectionPlayText, Mode=OneWay}"
                                                    Visibility="{x:Bind CollectionHasCompleted, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                    Tag="{x:Bind}"
                                                    Click="PlayFirstCollectionBtn_Click" />
                                                <Button
                                                    locui:Localized.Content="取消未完成集"
                                                    Visibility="{x:Bind CollectionHasActive, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                    Tag="{x:Bind}"
                                                    Click="CancelCollectionBtn_Click" />
                                                <Button
                                                    locui:Localized.ToolTip="删除合集"
                                                    Tag="{x:Bind}"
                                                    Click="DeleteCollectionBtn_Click">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                </Button>
                                            </controls:WrapPanel>
                                        </StackPanel>

                                        <!-- 展开的子集明细行 -->
                                        <Border
                                            Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10">
                                            <ItemsRepeater ItemsSource="{x:Bind Episodes, Mode=OneWay}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="8" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:TaskEpisodeViewModel">
                                                        <StackPanel Spacing="6" Padding="2,4">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Style="{StaticResource OmniTagBorderStyle}" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind EpisodeTag, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock
                                                                        Text="{x:Bind DetailLine, Mode=OneWay}"
                                                                        ToolTipService.ToolTip="{x:Bind DetailLine, Mode=OneWay}"
                                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        TextWrapping="WrapWholeWords" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="6">
                                                                <Button Content="{x:Bind ActionText, Mode=OneWay}" Padding="8,3" Visibility="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource BoolToVis}}" Tag="{x:Bind Task, Mode=OneWay}" Click="PlayTaskBtn_Click" />
                                                                <Button locui:Localized.Content="定位" Padding="8,3" Visibility="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource BoolToVis}}" Tag="{x:Bind Task, Mode=OneWay}" Click="LocateTaskBtn_Click" />
                                                                <Button locui:Localized.Content="重试" Padding="8,3" Visibility="{x:Bind IsFailedOrCancelled, Mode=OneWay, Converter={StaticResource BoolToVis}}" Tag="{x:Bind Task, Mode=OneWay}" Click="RetryTaskBtn_Click" />
                                                                <Button locui:Localized.Content="取消" Padding="8,3" Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVis}}" Tag="{x:Bind Task, Mode=OneWay}" Click="CancelTaskBtn_Click" />
                                                            </controls:WrapPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
