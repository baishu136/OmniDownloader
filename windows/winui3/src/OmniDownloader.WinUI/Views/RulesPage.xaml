<Page
    x:Class="OmniDownloader.WinUI.Views.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:locui="using:OmniDownloader.WinUI.Helpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OmniDownloader.WinUI.ViewModels"
    xmlns:models="using:OmniDownloader.WinUI.Core.Models"
    xmlns:controls="using:OmniDownloader.WinUI.Controls"
    SizeChanged="Page_SizeChanged"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="ContentContainer" MaxWidth="940" Margin="22,14,22,26">
            <StackPanel Spacing="14">
                <!-- 1. 顶部标题与全局导入导出操作 -->
                <Grid RowSpacing="10" ColumnSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="4">
                            <TextBlock x:Name="PageTitleText" locui:Localized.Text="下载规则" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <Border Style="{StaticResource OmniTagBorderStyle}" VerticalAlignment="Center">
                                <TextBlock Text="Omni Rules v1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                        </controls:WrapPanel>
                        <TextBlock locui:Localized.Text="通过统一 JSON 协议编排普通、合集、批量及剪贴板自动下载行为" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <controls:WrapPanel x:Name="HeaderActionsPanel" Grid.Row="0" Grid.Column="1" HorizontalSpacing="8" VerticalSpacing="8" VerticalAlignment="Center">
                        <ToggleSwitch
                            locui:Localized.OffContent="规则系统已关闭"
                            locui:Localized.OnContent="规则系统已启用"
                            IsOn="{x:Bind Vm.RulesSystemEnabled, Mode=TwoWay}"
                            MinWidth="0" />
                        <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.ResetEditorToNewRuleCommand}" Click="NewRuleScroll_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock locui:Localized.Text="新建规则" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind Vm.ImportRulesFileCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B5;" FontSize="13" />
                                <TextBlock locui:Localized.Text="导入规则" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind Vm.ExportRulesFileCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEDE1;" FontSize="13" />
                                <TextBlock locui:Localized.Text="导出 .omnirule.json" />
                            </StackPanel>
                        </Button>
                    </controls:WrapPanel>
                </Grid>

                <!-- 2. Windows 系统事件驱动剪贴板监听控制条 -->
                <Border Style="{StaticResource OmniCardBorderStyle}" Padding="14,12">
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="4">
                                <FontIcon Glyph="&#xE77F;" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock locui:Localized.Text="剪贴板自动下载监听（零轮询系统事件）" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource OmniTagBorderStyle}" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Vm.ClipboardStatusSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Border>
                            </controls:WrapPanel>
                            <TextBlock locui:Localized.Text="自动提取分享文本中的单个或多个链接，仅处理命中已启用规则的媒体；遇到验证或登录受限时自动暂停并提示" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <controls:WrapPanel Grid.Column="1" HorizontalSpacing="8" VerticalSpacing="6" VerticalAlignment="Center">
                            <ToggleSwitch
                                locui:Localized.OffContent="监听关闭"
                                locui:Localized.OnContent="监听开启"
                                MinWidth="0"
                                IsOn="{x:Bind Vm.ClipboardWatchEnabled, Mode=TwoWay}" />
                            <Button
                                Content="{x:Bind Vm.ClipboardPauseButtonText, Mode=OneWay}"
                                Visibility="{x:Bind Vm.ClipboardWatchEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                Command="{x:Bind Vm.ToggleClipboardPauseCommand}" />
                            <CheckBox
                                locui:Localized.Content="托盘气泡提醒"
                                MinWidth="0"
                                IsChecked="{x:Bind Vm.ClipboardShowTrayNotice, Mode=TwoWay}"
                                Click="ClipboardPolicyField_Changed" />
                        </controls:WrapPanel>
                    </Grid>
                </Border>

                <!-- 3. 待用户确认入队提示列表（当规则动作设为 confirm 时出现） -->
                <Border
                    Style="{StaticResource OmniCardBorderStyle}"
                    Visibility="{x:Bind Vm.HasPendingConfirmations, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="10">
                        <TextBlock locui:Localized.Text="待确认下载任务" Style="{StaticResource GroupHeaderTextStyle}" />
                        <ItemsRepeater ItemsSource="{x:Bind Vm.PendingConfirmations, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:PendingConfirmationDto">
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Url}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="4">
                                                    <Border Style="{StaticResource OmniTagBorderStyle}">
                                                        <TextBlock Text="{x:Bind RuleName}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                    </Border>
                                                    <Border Style="{StaticResource OmniTagBorderStyle}">
                                                        <TextBlock Text="{x:Bind QualitySummary}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                    </Border>
                                                </controls:WrapPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button locui:Localized.Content="确认下载" Style="{StaticResource AccentButtonStyle}" Tag="{x:Bind ConfirmId}" Click="ApproveConfirmBtn_Click" />
                                                <Button locui:Localized.Content="忽略" Tag="{x:Bind ConfirmId}" Click="DismissConfirmBtn_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- 4. 子视图切换条：规则管理与编辑 / 链接测试台 / 执行记录 -->
                <SelectorBar x:Name="RulesSectionBar" SelectionChanged="RulesSectionBar_SelectionChanged">
                    <SelectorBarItem x:Name="SectionRulesItem" locui:Localized.Text="规则管理与编辑器" Tag="rules" IsSelected="True" />
                    <SelectorBarItem x:Name="SectionTestItem" locui:Localized.Text="测试链接预览" Tag="test" />
                    <SelectorBarItem x:Name="SectionLogsItem" locui:Localized.Text="执行记录与去重" Tag="logs" />
                </SelectorBar>

                <!-- === 视图 A：规则管理列表 + 编辑器 === -->
                <StackPanel x:Name="PanelRules" Spacing="14">
                    <!-- 规则队列与优先级排序卡 -->
                    <Border Style="{StaticResource OmniCardBorderStyle}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock locui:Localized.Text="已配置规则列表（按优先级从高到低匹配首个完整命中项）" Style="{StaticResource GroupHeaderTextStyle}" />
                            </Grid>

                            <TextBlock
                                locui:Localized.Text="尚未添加自定义规则。点击「新建规则」或导入 .omnirule.json 文件开始定制自动化流程；无规则匹配时保持原有下载逻辑不变。"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind Vm.HasRules, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                            <ItemsRepeater ItemsSource="{x:Bind Vm.Rules, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RuleListItemVm">
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9">
                                            <Grid ColumnSpacing="10" RowSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <ToggleSwitch Grid.Column="0" MinWidth="0" OnContent="" OffContent="" IsOn="{x:Bind IsEnabled, Mode=OneWay}" Tag="{x:Bind}" Toggled="RuleEnabledSwitch_Toggled" VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="4">
                                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                        <Border Style="{StaticResource OmniTagBorderStyle}" Visibility="{x:Bind IsImportedUntrusted, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock locui:Localized.Text="外源导入·需确认" Style="{StaticResource CaptionTextBlockStyle}" />
                                                        </Border>
                                                    </controls:WrapPanel>
                                                    <TextBlock Text="{x:Bind SummaryLine, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <controls:WrapPanel Grid.Column="2" HorizontalSpacing="6" VerticalSpacing="6" VerticalAlignment="Center">
                                                    <Button Padding="8,4" locui:Localized.ToolTip="上移优先级" Tag="{x:Bind}" Click="MoveRuleUpBtn_Click">
                                                        <FontIcon Glyph="&#xE74A;" FontSize="12" />
                                                    </Button>
                                                    <Button Padding="8,4" locui:Localized.ToolTip="下移优先级" Tag="{x:Bind}" Click="MoveRuleDownBtn_Click">
                                                        <FontIcon Glyph="&#xE74B;" FontSize="12" />
                                                    </Button>
                                                    <Button locui:Localized.Content="编辑" Padding="10,4" Tag="{x:Bind}" Click="EditRuleBtn_Click" />
                                                    <Button locui:Localized.Content="复制" Padding="10,4" Tag="{x:Bind}" Click="DuplicateRuleBtn_Click" />
                                                    <Button locui:Localized.Content="删除" Padding="10,4" Tag="{x:Bind}" Click="DeleteRuleBtn_Click" />
                                                </controls:WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <!-- 规则编辑器卡片（可视化表单 ↔ 高级 JSON 编辑器） -->
                    <Border x:Name="RuleEditorCard" Style="{StaticResource OmniCardBorderStyle}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" locui:Localized.Text="规则编辑器" Style="{StaticResource PageSectionTitleStyle}" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="1" IsChecked="{x:Bind Vm.IsJsonMode, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE943;" FontSize="13" />
                                        <TextBlock locui:Localized.Text="高级 JSON 编辑器" />
                                    </StackPanel>
                                </ToggleButton>
                            </Grid>

                            <!-- 可视化规则编辑器 -->
                            <StackPanel Spacing="12" Visibility="{x:Bind Vm.IsJsonMode, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                <Grid ColumnSpacing="10" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" locui:Localized.Header="规则名称 *" Text="{x:Bind Vm.EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <NumberBox Grid.Column="1" locui:Localized.Header="优先级（越小越优先）" Minimum="0" Maximum="99999" SpinButtonPlacementMode="Inline" Value="{x:Bind Vm.EditPriority, Mode=TwoWay}" />
                                    <ToggleSwitch Grid.Column="2" locui:Localized.Header="启用规则" locui:Localized.OnContent="启用" locui:Localized.OffContent="禁用" IsOn="{x:Bind Vm.EditEnabled, Mode=TwoWay}" />
                                </Grid>

                                <TextBox locui:Localized.Header="规则说明" Text="{x:Bind Vm.EditDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <StackPanel Spacing="4">
                                    <TextBlock locui:Localized.Text="触发入口" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <controls:WrapPanel HorizontalSpacing="14" VerticalSpacing="6">
                                        <CheckBox locui:Localized.Content="普通手动下载" IsChecked="{x:Bind Vm.EditTriggerManual, Mode=TwoWay}" />
                                        <CheckBox locui:Localized.Content="合集筛选下载" IsChecked="{x:Bind Vm.EditTriggerCollection, Mode=TwoWay}" />
                                        <CheckBox locui:Localized.Content="批量链接下载" IsChecked="{x:Bind Vm.EditTriggerBatch, Mode=TwoWay}" />
                                        <CheckBox locui:Localized.Content="剪贴板自动捕获" IsChecked="{x:Bind Vm.EditTriggerClipboard, Mode=TwoWay}" />
                                    </controls:WrapPanel>
                                </StackPanel>

                                <!-- 匹配条件 -->
                                <TextBlock locui:Localized.Text="匹配条件（留空表示不限制）" Style="{StaticResource GroupHeaderTextStyle}" />
                                <Grid ColumnSpacing="10" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Row="0" Grid.Column="0" locui:Localized.Header="平台名称（逗号分隔，自动兼容全引擎）" locui:Localized.PlaceholderText="如：哔哩哔哩, YouTube, Pixiv" Text="{x:Bind Vm.EditPlatformsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Row="0" Grid.Column="1" locui:Localized.Header="域名过滤（逗号分隔）" locui:Localized.PlaceholderText="如：bilibili.com, youtube.com" Text="{x:Bind Vm.EditDomainsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBox Grid.Row="1" Grid.Column="0" locui:Localized.Header="URL 匹配模式" locui:Localized.PlaceholderText="关键词 / 通配符 / 正则表达式" Text="{x:Bind Vm.EditUrlPatternsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox x:Name="UrlMatchModeCombo" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" locui:Localized.Header="URL 匹配方式" SelectionChanged="UrlMatchModeCombo_SelectionChanged">
                                        <ComboBoxItem locui:Localized.Content="包含关键词 (contains)" Tag="contains" />
                                        <ComboBoxItem locui:Localized.Content="通配符 (wildcard)" Tag="wildcard" />
                                        <ComboBoxItem locui:Localized.Content="正则表达式 (regex)" Tag="regex" />
                                    </ComboBox>

                                    <TextBox Grid.Row="2" Grid.Column="0" locui:Localized.Header="内容类型（video / images / gif / audio）" Text="{x:Bind Vm.EditMediaTypesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" locui:Localized.Header="作者 / UP主关键词" Text="{x:Bind Vm.EditAuthorKeywordsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBox Grid.Row="3" Grid.Column="0" locui:Localized.Header="标题包含关键词" Text="{x:Bind Vm.EditTitleKeywordsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" locui:Localized.Header="标题排除关键词" Text="{x:Bind Vm.EditTitleExcludeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" locui:Localized.Header="标题正则（可选）" Text="{x:Bind Vm.EditTitleRegex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <NumberBox Grid.Column="1" locui:Localized.Header="最小时长(秒)" Minimum="0" Maximum="864000" Value="{x:Bind Vm.EditMinDurationSec, Mode=TwoWay}" />
                                    <NumberBox Grid.Column="2" locui:Localized.Header="最大时长(秒)" Minimum="0" Maximum="864000" Value="{x:Bind Vm.EditMaxDurationSec, Mode=TwoWay}" />
                                </Grid>

                                <!-- 合集筛选 -->
                                <TextBlock locui:Localized.Text="合集筛选策略" Style="{StaticResource GroupHeaderTextStyle}" />
                                <Grid ColumnSpacing="10" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CollectionModeCombo" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" locui:Localized.Header="分集筛选模式" SelectionChanged="CollectionModeCombo_SelectionChanged">
                                        <ComboBoxItem locui:Localized.Content="全部下载 (all)" Tag="all" />
                                        <ComboBoxItem locui:Localized.Content="指定分集编号 (episodes)" Tag="episodes" />
                                        <ComboBoxItem locui:Localized.Content="指定起止范围 (range)" Tag="range" />
                                        <ComboBoxItem locui:Localized.Content="仅按分集关键词 (keywords)" Tag="keywords" />
                                    </ComboBox>
                                    <TextBox Grid.Row="0" Grid.Column="1" locui:Localized.Header="分集列表（如 1,3,5-8）" Text="{x:Bind Vm.EditCollectionEpisodes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Grid.Row="0" Grid.Column="2" locui:Localized.Content="跳过已下载分集" VerticalAlignment="Bottom" IsChecked="{x:Bind Vm.EditSkipDownloaded, Mode=TwoWay}" />

                                    <NumberBox Grid.Row="1" Grid.Column="0" locui:Localized.Header="起始分集号" Minimum="0" Maximum="10000" Value="{x:Bind Vm.EditCollectionRangeStart, Mode=TwoWay}" />
                                    <NumberBox Grid.Row="1" Grid.Column="1" locui:Localized.Header="结束分集号" Minimum="0" Maximum="10000" Value="{x:Bind Vm.EditCollectionRangeEnd, Mode=TwoWay}" />
                                    <TextBox Grid.Row="1" Grid.Column="2" MinWidth="180" locui:Localized.Header="分集包含/排除词用下方 JSON" Visibility="Collapsed" />
                                </Grid>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" locui:Localized.Header="分集标题包含词" Text="{x:Bind Vm.EditCollectionIncludeKw, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="1" locui:Localized.Header="分集标题排除词" Text="{x:Bind Vm.EditCollectionExcludeKw, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <!-- 下载与质量参数 -->
                                <TextBlock locui:Localized.Text="下载参数与画质回退策略" Style="{StaticResource GroupHeaderTextStyle}" />
                                <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="10">
                                    <ComboBox x:Name="RuleDownloadModeCombo" MinWidth="185" locui:Localized.Header="下载导出类型" SelectionChanged="RuleDownloadModeCombo_SelectionChanged">
                                        <ComboBoxItem locui:Localized.Content="视频（音画合流）" Tag="VIDEO_WITH_AUDIO" />
                                        <ComboBoxItem locui:Localized.Content="纯视频（无音轨）" Tag="VIDEO_ONLY" />
                                        <ComboBoxItem locui:Localized.Content="仅音频" Tag="AUDIO_ONLY" />
                                        <ComboBoxItem Content="GIF" Tag="GIF" />
                                        <ComboBoxItem locui:Localized.Content="高清封面" Tag="COVER" />
                                        <ComboBoxItem locui:Localized.Content="原始图片（逐张）" Tag="IMAGE" />
                                        <ComboBoxItem locui:Localized.Content="图文打包 ZIP" Tag="IMAGE_ZIP" />
                                    </ComboBox>
                                    <ComboBox x:Name="RuleQualityStrategyCombo" MinWidth="170" locui:Localized.Header="画质选择策略" SelectionChanged="RuleQualityStrategyCombo_SelectionChanged">
                                        <ComboBoxItem locui:Localized.Content="最高可用画质" Tag="best" />
                                        <ComboBoxItem locui:Localized.Content="指定目标分辨率" Tag="target_resolution" />
                                    </ComboBox>
                                    <NumberBox MinWidth="120" locui:Localized.Header="目标高度(px)" Minimum="0" Maximum="4320" Value="{x:Bind Vm.EditQualityResolution, Mode=TwoWay}" />
                                    <ComboBox x:Name="RuleCodecCombo" MinWidth="135" locui:Localized.Header="编码偏好" SelectionChanged="RuleCodecCombo_SelectionChanged">
                                        <ComboBoxItem locui:Localized.Content="自动" Tag="auto" />
                                        <ComboBoxItem Content="HEVC (H.265)" Tag="hev1" />
                                        <ComboBoxItem Content="H.264 (AVC)" Tag="avc1" />
                                        <ComboBoxItem Content="AV1" Tag="av01" />
                                        <ComboBoxItem Content="VP9" Tag="vp9" />
                                    </ComboBox>
                                    <NumberBox MinWidth="110" locui:Localized.Header="最低帧率" Minimum="0" Maximum="240" Value="{x:Bind Vm.EditQualityMinFps, Mode=TwoWay}" />
                                    <ComboBox x:Name="RuleDynamicRangeCombo" MinWidth="130" locui:Localized.Header="动态范围" SelectionChanged="RuleDynamicRangeCombo_SelectionChanged">
                                        <ComboBoxItem locui:Localized.Content="自动" Tag="auto" />
                                        <ComboBoxItem Content="HDR" Tag="HDR" />
                                        <ComboBoxItem Content="SDR" Tag="SDR" />
                                    </ComboBox>
                                    <ComboBox x:Name="RuleContainerCombo" MinWidth="120" locui:Localized.Header="视频容器" SelectionChanged="RuleContainerCombo_SelectionChanged">
                                        <ComboBoxItem Content="MP4" Tag="mp4" />
                                        <ComboBoxItem Content="MKV" Tag="mkv" />
                                        <ComboBoxItem Content="WebM" Tag="webm" />
                                        <ComboBoxItem locui:Localized.Content="自动" Tag="auto" />
                                    </ComboBox>
                                    <ComboBox x:Name="RuleAudioFormatCombo" MinWidth="120" locui:Localized.Header="音频格式" SelectionChanged="RuleAudioFormatCombo_SelectionChanged">
                                        <ComboBoxItem Content="MP3" Tag="mp3" />
                                        <ComboBoxItem Content="M4A" Tag="m4a" />
                                        <ComboBoxItem Content="FLAC" Tag="flac" />
                                        <ComboBoxItem Content="OPUS" Tag="opus" />
                                    </ComboBox>
                                    <ComboBox x:Name="RuleFallbackCombo" MinWidth="195" locui:Localized.Header="质量回退策略" SelectionChanged="RuleFallbackCombo_SelectionChanged">
                                        <ComboBoxItem locui:Localized.Content="自动回退最高可用" Tag="best_available" />
                                        <ComboBoxItem locui:Localized.Content="回退最近较低规格" Tag="closest_lower" />
                                        <ComboBoxItem locui:Localized.Content="严格匹配失败则中断" Tag="exact_or_fail" />
                                    </ComboBox>
                                    <CheckBox locui:Localized.Content="同时保存封面" VerticalAlignment="Bottom" IsChecked="{x:Bind Vm.EditSaveCover, Mode=TwoWay}" />
                                </controls:WrapPanel>

                                <!-- 文件管理与执行动作 -->
                                <TextBlock locui:Localized.Text="安全文件归档与执行动作" Style="{StaticResource GroupHeaderTextStyle}" />
                                <Grid ColumnSpacing="10" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Row="0" Grid.Column="0" locui:Localized.Header="命名模板（可用 {title} {author} {platform} {id} {episodeIndex}）" Text="{x:Bind Vm.EditFilenameTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Row="0" Grid.Column="1" locui:Localized.Header="相对分类子目录（限下载目录内）" locui:Localized.PlaceholderText="如：{platform}/{author}" Text="{x:Bind Vm.EditCategoryDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Grid.Row="0" Grid.Column="2" locui:Localized.Content="合集创建独立子目录" VerticalAlignment="Bottom" IsChecked="{x:Bind Vm.EditCollectionSubfolder, Mode=TwoWay}" />

                                    <ComboBox x:Name="RuleDuplicateCombo" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" locui:Localized.Header="重名文件处理" SelectionChanged="RuleDuplicateCombo_SelectionChanged">
                                        <ComboBoxItem locui:Localized.Content="自动递增重命名" Tag="rename" />
                                        <ComboBoxItem locui:Localized.Content="跳过复用已有文件" Tag="skip" />
                                        <ComboBoxItem locui:Localized.Content="覆盖已有文件" Tag="overwrite" />
                                    </ComboBox>
                                    <ComboBox x:Name="RuleExecutionCombo" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" locui:Localized.Header="匹配后执行策略" SelectionChanged="RuleExecutionCombo_SelectionChanged">
                                        <ComboBoxItem locui:Localized.Content="直接自动下载" Tag="auto_download" />
                                        <ComboBoxItem locui:Localized.Content="弹出确认后下载" Tag="confirm" />
                                        <ComboBoxItem locui:Localized.Content="仅解析不下载" Tag="parse_only" />
                                        <ComboBoxItem locui:Localized.Content="命中后忽略" Tag="ignore" />
                                    </ComboBox>
                                    <NumberBox Grid.Row="1" Grid.Column="2" locui:Localized.Header="单次最大任务数" Minimum="1" Maximum="200" Value="{x:Bind Vm.EditMaxTasks, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>

                            <!-- 高级 JSON 编辑器 + Schema 字段说明 -->
                            <StackPanel Spacing="10" Visibility="{x:Bind Vm.IsJsonMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                    <Button locui:Localized.Content="从表单重新生成 JSON" Click="SyncFormToJsonBtn_Click" />
                                    <Button locui:Localized.Content="校验 JSON 与安全性" Command="{x:Bind Vm.ValidateEditorJsonCommand}" />
                                    <ToggleButton IsChecked="{x:Bind Vm.IsSchemaDocsOpen, Mode=TwoWay}">
                                        <TextBlock locui:Localized.Text="查看字段说明" />
                                    </ToggleButton>
                                </controls:WrapPanel>

                                <InfoBar
                                    IsOpen="{x:Bind Vm.HasJsonValidationMessage, Mode=OneWay}"
                                    IsClosable="False"
                                    Severity="{x:Bind JsonMsgSeverity(Vm.JsonValidationError), Mode=OneWay}"
                                    Message="{x:Bind Vm.JsonValidationMessage, Mode=OneWay}" />

                                <TextBox
                                    Text="{x:Bind Vm.EditorJsonText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AcceptsReturn="True"
                                    FontFamily="Consolas"
                                    MinHeight="280"
                                    MaxHeight="460"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto" />

                                <Border
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6"
                                    Padding="12"
                                    Visibility="{x:Bind Vm.IsSchemaDocsOpen, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Spacing="6">
                                        <TextBlock locui:Localized.Text="Omni Download Rules JSON 字段协议参考" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <ItemsRepeater ItemsSource="{x:Bind Vm.SchemaDocs, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="4" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:RuleSchemaDocItem">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="220" />
                                                            <ColumnDefinition Width="95" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{x:Bind Field}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Type}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind Desc}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="8">
                                <Button Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind NotBusy(Vm.IsBusy), Mode=OneWay}" Command="{x:Bind Vm.SaveRuleCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                        <TextBlock locui:Localized.Text="保存规则" />
                                    </StackPanel>
                                </Button>
                                <Button locui:Localized.Content="重置为新建" Command="{x:Bind Vm.ResetEditorToNewRuleCommand}" />
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- === 视图 B：测试链接与计划预览台 === -->
                <StackPanel x:Name="PanelTest" Spacing="14" Visibility="Collapsed">
                    <Border Style="{StaticResource OmniCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock locui:Localized.Text="规则干跑预览台（安全测试，不写入下载队列与磁盘）" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBox locui:Localized.Header="测试媒体链接" locui:Localized.PlaceholderText="输入任意视频/合集/图文链接..." Text="{x:Bind Vm.TestUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="8">
                                <ComboBox x:Name="TestTriggerCombo" MinWidth="170" locui:Localized.Header="模拟触发入口" SelectionChanged="TestTriggerCombo_SelectionChanged">
                                    <ComboBoxItem locui:Localized.Content="手动下载" Tag="manual" IsSelected="True" />
                                    <ComboBoxItem locui:Localized.Content="合集下载" Tag="collection" />
                                    <ComboBoxItem locui:Localized.Content="批量下载" Tag="batch" />
                                    <ComboBoxItem locui:Localized.Content="剪贴板触发" Tag="clipboard" />
                                </ComboBox>
                                <Button Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" IsEnabled="{x:Bind NotBusy(Vm.IsTesting), Mode=OneWay}" Command="{x:Bind Vm.RunTestPreviewCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE768;" FontSize="13" />
                                        <TextBlock locui:Localized.Text="测试匹配并预览计划" />
                                    </StackPanel>
                                </Button>
                            </controls:WrapPanel>

                            <Border
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8"
                                Padding="12"
                                Visibility="{x:Bind Vm.HasTestResult, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind Vm.TestHeadline, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="WrapWholeWords" />
                                    <TextBlock Text="{x:Bind Vm.TestDetailsText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- === 视图 C：执行记录与跨入口去重索引 === -->
                <StackPanel x:Name="PanelLogs" Spacing="14" Visibility="Collapsed">
                    <Border Style="{StaticResource OmniCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock locui:Localized.Text="规则执行流水与跨入口去重记录" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind FormatDedupSummary(Vm.DedupCount), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <controls:WrapPanel Grid.Column="1" HorizontalSpacing="8" VerticalSpacing="6" VerticalAlignment="Center">
                                    <Button locui:Localized.Content="清理去重索引" Command="{x:Bind Vm.ClearDedupIndexCommand}" />
                                    <Button locui:Localized.Content="清空记录" Command="{x:Bind Vm.ClearAuditLogsCommand}" />
                                </controls:WrapPanel>
                            </Grid>

                            <TextBlock
                                locui:Localized.Text="暂无规则执行记录"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind Vm.HasAuditLogs, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                            <ItemsRepeater ItemsSource="{x:Bind Vm.AuditLogs, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:RuleAuditItemDto">
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <controls:WrapPanel Grid.Column="0" HorizontalSpacing="6" VerticalSpacing="4">
                                                        <Border Style="{StaticResource OmniTagBorderStyle}">
                                                            <TextBlock Text="{x:Bind Status}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                        </Border>
                                                        <Border Style="{StaticResource OmniTagBorderStyle}">
                                                            <TextBlock Text="{x:Bind Trigger}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                        </Border>
                                                        <TextBlock Text="{x:Bind RuleName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    </controls:WrapPanel>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Platform}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>
                                                <TextBlock Text="{x:Bind Reason}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords" />
                                                <TextBlock Text="{x:Bind Url}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
