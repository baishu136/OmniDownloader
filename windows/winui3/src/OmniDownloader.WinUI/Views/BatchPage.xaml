<Page
    x:Class="OmniDownloader.WinUI.Views.BatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:locui="using:OmniDownloader.WinUI.Helpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OmniDownloader.WinUI.ViewModels"
    xmlns:controls="using:OmniDownloader.WinUI.Controls"
    SizeChanged="Page_SizeChanged"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="ContentContainer" MaxWidth="940" Margin="22,14,22,26">
            <StackPanel Spacing="14">
                <!-- 头部 -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock x:Name="PageTitleText" Text="{x:Bind Vm.Loc.BatchTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Vm.Loc.BatchSubtitle, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <HyperlinkButton Grid.Column="1" locui:Localized.Content="查看任务" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{x:Bind Vm.NavigateToTasksCommand}" />
                </Grid>

                <!-- 批量文本导入卡片 -->
                <Border Style="{StaticResource OmniCardBorderStyle}">
                    <StackPanel Spacing="12">
                        <SelectorBar x:Name="InputModeBar" SelectionChanged="InputModeBar_SelectionChanged">
                            <SelectorBarItem x:Name="SmartModeItem" locui:Localized.Text="智能识别" Tag="smart" IsSelected="True" />
                            <SelectorBarItem x:Name="ManualModeItem" locui:Localized.Text="逐条输入" Tag="manual" />
                        </SelectorBar>

                        <TextBox
                            x:Name="BatchRawBox"
                            Text="{x:Bind Vm.RawInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="104"
                            MaxHeight="220"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            locui:Localized.PlaceholderText="粘贴包含多个视频或图文链接的分享文本（自动提取 http 链接 / BV 号），每批最多 100 条..." />

                        <InfoBar
                            IsOpen="{x:Bind Vm.HasValidationError, Mode=OneWay}"
                            IsClosable="False"
                            Severity="Warning"
                            Message="{x:Bind Vm.ValidationError, Mode=OneWay}" />

                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                            <Button locui:Localized.Content="粘贴剪贴板" Command="{x:Bind Vm.PasteFromClipboardCommand}" />
                            <Button locui:Localized.Content="导入 TXT" Command="{x:Bind Vm.ImportTxtFileCommand}" />
                            <Button
                                Style="{StaticResource AccentButtonStyle}"
                                Content="{x:Bind AddButtonLabel(Vm.IsManualMode), Mode=OneWay}"
                                Command="{x:Bind Vm.AddFromInputCommand}" />
                        </controls:WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 待下载草稿清单与参数提交卡片 -->
                <Border
                    Style="{StaticResource OmniCardBorderStyle}"
                    Visibility="{x:Bind Vm.HasDraftLinks, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Vm.DraftHeader, Mode=OneWay}" Style="{StaticResource GroupHeaderTextStyle}" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" locui:Localized.Content="清空输入" HorizontalAlignment="Right" Command="{x:Bind Vm.ClearDraftCommand}" />
                        </Grid>

                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                            <ScrollViewer MaxHeight="220">
                                <ItemsRepeater ItemsSource="{x:Bind Vm.DraftLinks, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="4" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid Padding="6,4" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="1" locui:Localized.Content="移除" Padding="8,3" Tag="{x:Bind}" Click="RemoveDraftBtn_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </Border>

                        <!-- 导出参数（流式自动折行，窄屏永不压瘪） -->
                        <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="10">
                            <ComboBox
                                x:Name="BatchTypeCombo"
                                MinWidth="210"
                                locui:Localized.Header="批量导出模式"
                                SelectedIndex="0"
                                SelectionChanged="BatchTypeCombo_SelectionChanged">
                                <ComboBoxItem locui:Localized.Content="视频（图文自动 ZIP）" Tag="VIDEO_WITH_AUDIO" />
                                <ComboBoxItem locui:Localized.Content="纯画面" Tag="VIDEO_ONLY" />
                                <ComboBoxItem locui:Localized.Content="音频" Tag="AUDIO_ONLY" />
                                <ComboBoxItem Content="GIF" Tag="GIF" />
                                <ComboBoxItem locui:Localized.Content="保存原图（逐张图片）" Tag="IMAGE" />
                                <ComboBoxItem locui:Localized.Content="图集导出 ZIP" Tag="IMAGE_ZIP" />
                            </ComboBox>

                            <ComboBox
                                x:Name="BatchAudioCombo"
                                MinWidth="112"
                                locui:Localized.Header="音频格式"
                                SelectedIndex="0"
                                Visibility="{x:Bind Vm.IsAudioFormatVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                SelectionChanged="BatchAudioCombo_SelectionChanged">
                                <ComboBoxItem Content="MP3" Tag="mp3" />
                                <ComboBoxItem Content="M4A" Tag="m4a" />
                                <ComboBoxItem Content="FLAC" Tag="flac" />
                                <ComboBoxItem Content="OPUS" Tag="opus" />
                            </ComboBox>

                            <ToggleSwitch
                                locui:Localized.Header="合集选项"
                                locui:Localized.OffContent="仅当前"
                                locui:Localized.OnContent="下载全部分集"
                                IsOn="{x:Bind Vm.DownloadAllEpisodes, Mode=TwoWay}" />

                            <ComboBox
                                x:Name="BatchRuleCombo"
                                MinWidth="200"
                                locui:Localized.Header="下载规则（可选）"
                                ItemsSource="{x:Bind Vm.QuickRuleChoices, Mode=OneWay}"
                                DisplayMemberPath="DisplayName"
                                SelectedIndex="0"
                                SelectionChanged="BatchRuleCombo_SelectionChanged" />
                        </controls:WrapPanel>

                        <Button
                            HorizontalAlignment="Stretch"
                            Padding="14,10"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind NotSubmitting(Vm.IsSubmitting), Mode=OneWay}"
                            Command="{x:Bind Vm.StartBatchCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    IsActive="{x:Bind Vm.IsSubmitting, Mode=OneWay}"
                                    Visibility="{x:Bind Vm.IsSubmitting, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <TextBlock locui:Localized.Text="开始批量下载" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 批次处理历史与单条状态追踪 -->
                <StackPanel
                    Spacing="10"
                    Visibility="{x:Bind Vm.HasJobs, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:WrapPanel Grid.Column="0" HorizontalSpacing="10" VerticalSpacing="4" VerticalAlignment="Center">
                            <TextBlock locui:Localized.Text="批次记录" Style="{StaticResource GroupHeaderTextStyle}" />
                            <TextBlock
                                Text="{x:Bind Vm.SummaryText, Mode=OneWay}"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </controls:WrapPanel>
                        <Button
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{x:Bind Vm.ClearBatchJobsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                <TextBlock locui:Localized.Text="清空解析记录" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ItemsRepeater ItemsSource="{x:Bind Vm.Jobs, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:BatchJobViewItem">
                                <Border Style="{StaticResource OmniCardBorderStyle}">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind HeaderText}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" Style="{StaticResource OmniTagBorderStyle}">
                                                <TextBlock Text="{x:Bind StatusBadge}" Style="{StaticResource CaptionTextBlockStyle}" />
                                            </Border>
                                        </Grid>

                                        <ProgressBar
                                            Value="{x:Bind ProgressPercent}"
                                            Maximum="100"
                                            Visibility="{x:Bind IsRunning, Converter={StaticResource BoolToVis}}" />

                                        <ItemsRepeater ItemsSource="{x:Bind Rows}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="4" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:BatchJobRowViewItem">
                                                    <Grid ColumnSpacing="8" Padding="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{x:Bind Url}" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Note}" MaxWidth="140" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                        <Button
                                                            Grid.Column="2"
                                                            locui:Localized.Content="单条解析"
                                                            Padding="8,2"
                                                            Visibility="{x:Bind CanSendToSingleAnalyze, Converter={StaticResource BoolToVis}}"
                                                            Tag="{x:Bind Url}"
                                                            Click="SendSingleAnalyzeBtn_Click" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>

                                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                            <Button
                                                locui:Localized.Content="停止添加下载"
                                                Visibility="{x:Bind IsRunning, Converter={StaticResource BoolToVis}}"
                                                Tag="{x:Bind Job.Id}"
                                                Click="CancelBatchBtn_Click" />
                                            <Button
                                                locui:Localized.Content="重试失败或停止的链接"
                                                Visibility="{x:Bind HasRetryable, Converter={StaticResource BoolToVis}}"
                                                Tag="{x:Bind Job.Id}"
                                                Click="RetryBatchBtn_Click" />
                                        </controls:WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
