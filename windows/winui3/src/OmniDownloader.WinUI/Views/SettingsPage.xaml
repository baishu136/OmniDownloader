<Page
    x:Class="OmniDownloader.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OmniDownloader.WinUI.Controls"
    xmlns:models="using:OmniDownloader.WinUI.Core.Models"
    SizeChanged="Page_SizeChanged"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="ContentContainer" MaxWidth="820" Margin="28,18,28,32">
            <StackPanel Spacing="16">
                <!-- Windows 11 原生面包屑分层头 -->
                <StackPanel Spacing="4">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button
                                Visibility="{x:Bind Vm.IsRootPage, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                ToolTipService.ToolTip="返回偏好设置"
                                Click="BackToRoot_Click">
                                <FontIcon Glyph="&#xE72B;" FontSize="14" />
                            </Button>
                            <BreadcrumbBar x:Name="SettingsBreadcrumb" ItemClicked="SettingsBreadcrumb_ItemClicked" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 0. 一级总览 (ROOT) -->
                <StackPanel Spacing="10" Visibility="{x:Bind Vm.IsRootPage, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="外观与语言" Style="{StaticResource GroupHeaderTextStyle}" />

                    <controls:OmniSettingsCard
                        Title="{x:Bind Vm.Loc.LanguageLabel, Mode=OneWay}"
                        Description="支持简中、繁中、English 与日本語即时切换"
                        Glyph="&#xE774;">
                        <ComboBox x:Name="LanguageCombo" MinWidth="128" SelectionChanged="LanguageCombo_SelectionChanged">
                            <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                            <ComboBoxItem Content="繁體中文" Tag="zh-TW" />
                            <ComboBoxItem Content="English" Tag="en" />
                            <ComboBoxItem Content="日本語" Tag="ja" />
                        </ComboBox>
                    </controls:OmniSettingsCard>

                    <controls:OmniSettingsCard
                        Title="{x:Bind Vm.Loc.ThemeLabel, Mode=OneWay}"
                        Description="自动跟随 Windows 10/11 系统深浅色与系统强调色"
                        Glyph="&#xE790;">
                        <ComboBox x:Name="ThemeCombo" MinWidth="128" SelectionChanged="ThemeCombo_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="auto" />
                            <ComboBoxItem Content="浅色" Tag="light" />
                            <ComboBoxItem Content="深色" Tag="dark" />
                        </ComboBox>
                    </controls:OmniSettingsCard>

                    <controls:OmniSettingsCard
                        Title="纯黑背景 (AMOLED)"
                        Description="深色模式下使用纯黑底层以增强对比度"
                        Glyph="&#xE708;">
                        <ToggleSwitch
                            OffContent="关闭"
                            OnContent="开启"
                            IsOn="{x:Bind Vm.UsePureBlackDark, Mode=TwoWay}" />
                    </controls:OmniSettingsCard>

                    <TextBlock Text="功能设置" Style="{StaticResource GroupHeaderTextStyle}" />

                    <controls:OmniSettingsCard
                        Title="下载与存储"
                        Description="保存目录、并发任务数与开机自启"
                        Glyph="&#xE8B7;"
                        IsClickEnabled="True"
                        Tag="downloads"
                        CardClicked="CategoryCard_Clicked" />

                    <controls:OmniSettingsCard
                        Title="网络代理"
                        Description="HTTP / HTTPS 与 SOCKS5 代理连接"
                        Glyph="&#xE968;"
                        IsClickEnabled="True"
                        Tag="network"
                        CardClicked="CategoryCard_Clicked" />

                    <controls:OmniSettingsCard
                        Title="中转站"
                        Description="添加、管理和删除第三方解析辅助站点"
                        Glyph="&#xE8A7;"
                        IsClickEnabled="True"
                        Tag="relay"
                        CardClicked="CategoryCard_Clicked" />

                    <controls:OmniSettingsCard
                        Title="账号与 Cookie 会话"
                        Description="浏览器一键登录、导入 Netscape Cookies 或哔哩哔哩 SESSDATA"
                        Glyph="&#xE77B;"
                        IsClickEnabled="True"
                        Tag="accounts"
                        CardClicked="CategoryCard_Clicked" />

                    <controls:OmniSettingsCard
                        Title="下载引擎与组件"
                        Description="本地核心服务连接、yt-dlp/FFmpeg 运行状态与版本更新"
                        Glyph="&#xE896;"
                        IsClickEnabled="True"
                        Tag="engine"
                        CardClicked="CategoryCard_Clicked" />

                    <controls:OmniSettingsCard
                        Title="关于"
                        Description="应用形态、支持平台目录与数据兼容性说明"
                        Glyph="&#xE946;"
                        IsClickEnabled="True"
                        Tag="about"
                        CardClicked="CategoryCard_Clicked" />
                </StackPanel>

                <!-- 1. 二级：下载与存储 -->
                <StackPanel x:Name="PanelDownloads" Spacing="10" Visibility="Collapsed">
                    <controls:OmniSettingsCard
                        Title="下载保存目录"
                        Description="{x:Bind Vm.DownloadDir, Mode=OneWay}"
                        Glyph="&#xE8B7;">
                        <Button Content="打开目录" Command="{x:Bind Vm.OpenDownloadFolderCommand}" />
                    </controls:OmniSettingsCard>

                    <Border Style="{StaticResource OmniCardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBox
                                Header="修改保存路径"
                                Text="{x:Bind Vm.DownloadDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="输入保存路径..." />
                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <Button Content="浏览文件夹..." Command="{x:Bind Vm.BrowseDownloadDirCommand}" />
                                <Button Content="保存路径" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.SaveDownloadDirCommand}" />
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>

                    <controls:OmniSettingsCard
                        Title="最大同时下载任务数"
                        Description="并发越高占用网络带宽越多（建议 2~5）"
                        Glyph="&#xE9D9;">
                        <NumberBox
                            x:Name="ConcurrentNumberBox"
                            Minimum="1"
                            Maximum="10"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind Vm.MaxConcurrentTasks, Mode=OneWay}"
                            ValueChanged="ConcurrentNumberBox_ValueChanged" />
                    </controls:OmniSettingsCard>

                    <controls:OmniSettingsCard
                        Title="开机自动运行网页/核心后台服务"
                        Description="随 Windows 启动在系统托盘静默运行本地引擎"
                        Glyph="&#xE7E8;">
                        <ToggleSwitch
                            x:Name="AutoStartToggle"
                            OffContent="关闭"
                            OnContent="开启"
                            IsOn="{x:Bind Vm.AutoStartWithWindows, Mode=OneWay}"
                            Toggled="AutoStartToggle_Toggled" />
                    </controls:OmniSettingsCard>
                </StackPanel>

                <!-- 2. 二级：网络代理 -->
                <StackPanel x:Name="PanelNetwork" Spacing="10" Visibility="Collapsed">
                    <Border Style="{StaticResource OmniCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="网络代理设置 (Proxy)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="支持 HTTP / HTTPS / SOCKS5 代理（如 http://127.0.0.1:7890 或 socks5://127.0.0.1:7891）；留空即直连网络。"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords" />

                            <TextBox
                                Header="代理服务器地址"
                                Text="{x:Bind Vm.ProxyUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="例如: http://127.0.0.1:7890" />

                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <Button Content="保存并应用" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.SaveProxyCommand}" />
                                <Button
                                    Content="清空代理"
                                    Visibility="{x:Bind Vm.HasProxy, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Command="{x:Bind Vm.ClearProxyCommand}" />
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3. 二级：中转站 -->
                <StackPanel x:Name="PanelRelay" Spacing="12" Visibility="Collapsed">
                    <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="8">
                        <TextBlock Text="{x:Bind Vm.RelaySectionTitle, Mode=OneWay}" Style="{StaticResource GroupHeaderTextStyle}" VerticalAlignment="Center" />
                        <Button
                            Content="添加中转网站"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind Vm.RequestAddRelaySiteCommand}" />
                    </controls:WrapPanel>

                    <Border
                        Style="{StaticResource OmniCardBorderStyle}"
                        Visibility="{x:Bind Vm.HasRelaySites, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <TextBlock
                            Text="暂未添加任何第三方解析中转站点，点击上方按钮即可添加常用站点（可自动读取网页标题）。"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="WrapWholeWords" />
                    </Border>

                    <ItemsRepeater ItemsSource="{x:Bind Vm.RelaySites, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:RelaySite">
                                <Border Style="{StaticResource OmniCardBorderStyle}">
                                    <StackPanel Spacing="8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{x:Bind Url}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                            <Button Content="访问解析" Tag="{x:Bind}" Click="OpenRelayBtn_Click" />
                                            <Button Content="移除" Tag="{x:Bind}" Click="DeleteRelayBtn_Click" />
                                        </controls:WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- 4. 二级：账号与 Cookie -->
                <StackPanel x:Name="PanelAccounts" Spacing="12" Visibility="Collapsed">
                    <InfoBar
                        IsOpen="{x:Bind Vm.ShowOutdatedBackendWarning, Mode=OneWay}"
                        IsClosable="False"
                        Severity="Warning"
                        Title="检测到旧版后台服务"
                        Message="{x:Bind Vm.OutdatedBackendWarningText, Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button Content="重连最新版核心" Command="{x:Bind Vm.ReconnectForLoginCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <Border Style="{StaticResource OmniCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="6">
                                <TextBlock Text="平台 Cookie 会话隔离仓库 (Windows DPAPI 加密)" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="WrapWholeWords" />
                                <Border Style="{StaticResource OmniTagBorderStyle}">
                                    <TextBlock Text="{x:Bind Vm.SessionStatusBadge, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                            </controls:WrapPanel>

                            <ComboBox
                                x:Name="SessionPlatformCombo"
                                Header="选择目标平台"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind Vm.SessionPlatforms}"
                                SelectedItem="{x:Bind Vm.SelectedSessionPlatform, Mode=TwoWay}" />

                            <ToggleSwitch
                                x:Name="SessionDisableCookieToggle"
                                Header="停用该平台 Cookie"
                                OffContent="使用已导入会话"
                                OnContent="强制匿名请求（仍保留原凭证）"
                                IsOn="{x:Bind Vm.IsSelectedPlatformCookieDisabled, Mode=OneWay}"
                                Toggled="SessionDisableCookieToggle_Toggled" />

                            <TextBlock Text="{x:Bind Vm.SessionPolicySummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />

                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <Button Content="浏览器登录" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.OpenBrowserLoginCommand}" />
                                <Button Content="保存会话并关闭" Command="{x:Bind Vm.SaveBrowserLoginCommand}" />
                                <Button Content="导入 Netscape cookies.txt" Command="{x:Bind Vm.ImportSessionCookiesFileCommand}" />
                                <Button Content="清除此平台会话" Command="{x:Bind Vm.ClearSelectedSessionCommand}" />
                            </controls:WrapPanel>

                            <TextBlock
                                Text="{x:Bind Vm.BrowserLoginStatusText, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>

                    <!-- 哔哩哔哩快速凭证区 -->
                    <Border Style="{StaticResource OmniCardBorderStyle}">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="4">
                                <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="4">
                                    <TextBlock Text="登录哔哩哔哩 (Cookie / SESSDATA)" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="WrapWholeWords" />
                                    <Border Style="{StaticResource OmniTagBorderStyle}" Visibility="{x:Bind Vm.HasBilibiliSession, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="凭据已保存，实际画质取决于账号权益与内容" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    </Border>
                                </controls:WrapPanel>
                                <TextBlock Text="解锁 1080P60 / 4K 超清画质与大会员片源" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <TextBox
                                Text="{x:Bind Vm.BilibiliCookieInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="粘贴 SESSDATA=xxx 或完整 Cookie 字符串" />

                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <Button Content="保存B站凭证" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.SaveBilibiliCookieCommand}" />
                                <Button
                                    Content="清空凭证"
                                    Visibility="{x:Bind Vm.HasBilibiliSession, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Command="{x:Bind Vm.ClearBilibiliCookieCommand}" />
                                <HyperlinkButton Content="如何获取 SESSDATA？" Command="{x:Bind Vm.ShowBilibiliGuideCommand}" />
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 5. 二级：下载引擎与服务连接 -->
                <StackPanel x:Name="PanelEngine" Spacing="10" Visibility="Collapsed">
                    <controls:OmniSettingsCard
                        Title="核心下载引擎运行状态"
                        Description="{x:Bind Vm.EngineStatusSummary, Mode=OneWay}"
                        Glyph="&#xE950;">
                        <Border Style="{StaticResource OmniTagBorderStyle}">
                            <TextBlock Text="{x:Bind Vm.EngineReadyBadge, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                    </controls:OmniSettingsCard>

                    <Border Style="{StaticResource OmniCardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="本地引擎连接配置" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBox
                                Header="引擎服务地址"
                                Text="{x:Bind Vm.ServiceBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="http://127.0.0.1:58000" />
                            <ToggleSwitch
                                Header="未检测到本地服务时自动伴随启动核心引擎"
                                OffContent="仅连接已有服务"
                                OnContent="自动伴随启动"
                                IsOn="{x:Bind Vm.AutoStartBackend, Mode=TwoWay}" />
                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <Button Content="保存连接设置并重连" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.SaveBackendConnectionCommand}" />
                                <Button Content="探测引擎组件状态" Command="{x:Bind Vm.CheckEngineDiagnosticsCommand}" />
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OmniCardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="应用与引擎更新检查" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind Vm.UpdateStatusText, Mode=OneWay}"
                                Visibility="{x:Bind Vm.UpdateStatusText, Mode=OneWay, Converter={StaticResource StrToVis}}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords" />
                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <Button Content="检查应用更新" Command="{x:Bind Vm.CheckUpdateCommand}" />
                                <Button
                                    Content="下载更新包"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind Vm.HasUpdateUrl, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Command="{x:Bind Vm.OpenUpdateDownloadUrlCommand}" />
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 6. 二级：关于 -->
                <StackPanel x:Name="PanelAbout" Spacing="12" Visibility="Collapsed">
                    <Border Style="{StaticResource OmniCardBorderStyle}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="OmniDownloader" Style="{StaticResource TitleTextBlockStyle}" />
                                <Border Style="{StaticResource OmniTagBorderStyle}" VerticalAlignment="Center">
                                    <TextBlock Text="v1.7.60 · WinUI 3" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind Vm.Loc.AboutNativeNote, Mode=OneWay}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>

                    <controls:OmniSettingsCard
                        Title="支持平台与解析器目录 (yt-dlp)"
                        Description="查看完整 1600+ 支持解析器与搜索过滤"
                        Glyph="&#xE774;"
                        IsClickEnabled="True"
                        CardClicked="AboutPlatformsCard_Clicked" />

                    <controls:OmniSettingsCard
                        Title="运行形态"
                        Description="Windows 原生桌面端 (WinUI 3 + Windows App SDK 1.6) · 连接本地 FastAPI 核心引擎"
                        Glyph="&#xE7F4;" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
