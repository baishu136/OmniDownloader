<Page
    x:Class="OmniDownloader.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:locui="using:OmniDownloader.WinUI.Helpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OmniDownloader.WinUI.Controls"
    xmlns:models="using:OmniDownloader.WinUI.Core.Models"
    xmlns:vm="using:OmniDownloader.WinUI.ViewModels"
    SizeChanged="Page_SizeChanged"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="ContentContainer" MaxWidth="820" Margin="28,18,28,32">
            <StackPanel Spacing="16">
                <!-- Windows 11 原生面包屑分层头 -->
                <StackPanel Spacing="4">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button
                                Visibility="{x:Bind Vm.IsRootPage, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                locui:Localized.ToolTip="返回偏好设置"
                                Click="BackToRoot_Click">
                                <FontIcon Glyph="&#xE72B;" FontSize="14" />
                            </Button>
                            <BreadcrumbBar x:Name="SettingsBreadcrumb" ItemClicked="SettingsBreadcrumb_ItemClicked" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 0. 一级总览 (ROOT) -->
                <StackPanel Spacing="10" Visibility="{x:Bind Vm.IsRootPage, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock locui:Localized.Text="外观与语言" Style="{StaticResource GroupHeaderTextStyle}" />

                    <controls:OmniSettingsCard
                        Title="{x:Bind Vm.Loc.LanguageLabel, Mode=OneWay}"
                        locui:Localized.Description="支持简中、繁中、English 与日本語即时切换"
                        Glyph="&#xE774;">
                        <ComboBox x:Name="LanguageCombo" MinWidth="128" SelectionChanged="LanguageCombo_SelectionChanged">
                            <ComboBoxItem locui:Localized.Content="简体中文" Tag="zh-CN" />
                            <ComboBoxItem locui:Localized.Content="繁體中文" Tag="zh-TW" />
                            <ComboBoxItem Content="English" Tag="en" />
                            <ComboBoxItem locui:Localized.Content="日本語" Tag="ja" />
                        </ComboBox>
                    </controls:OmniSettingsCard>

                    <controls:OmniSettingsCard
                        Title="{x:Bind Vm.Loc.ThemeLabel, Mode=OneWay}"
                        locui:Localized.Description="自动跟随 Windows 10/11 系统深浅色与系统强调色"
                        Glyph="&#xE790;">
                        <ComboBox x:Name="ThemeCombo" MinWidth="128" SelectionChanged="ThemeCombo_SelectionChanged">
                            <ComboBoxItem locui:Localized.Content="跟随系统" Tag="auto" />
                            <ComboBoxItem locui:Localized.Content="浅色" Tag="light" />
                            <ComboBoxItem locui:Localized.Content="深色" Tag="dark" />
                        </ComboBox>
                    </controls:OmniSettingsCard>

                    <controls:OmniSettingsCard
                        locui:Localized.Title="纯黑背景 (AMOLED)"
                        locui:Localized.Description="深色模式下使用纯黑底层以增强对比度"
                        Glyph="&#xE708;">
                        <ToggleSwitch
                            locui:Localized.OffContent="关闭"
                            locui:Localized.OnContent="开启"
                            IsOn="{x:Bind Vm.UsePureBlackDark, Mode=TwoWay}" />
                    </controls:OmniSettingsCard>

                    <!-- 自定义主题强调色卡片 -->
                    <Border Style="{StaticResource OmniCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE2B1;" FontSize="20" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock locui:Localized.Text="主题颜色" Style="{StaticResource BodyTextBlockStyle}" />
                                    <TextBlock
                                        locui:Localized.Text="自定义应用强调色与高亮控件，支持预设色板、取色器或恢复跟随系统"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <Border
                                    Grid.Column="2"
                                    CornerRadius="999"
                                    Padding="10,4"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border
                                            Width="12"
                                            Height="12"
                                            CornerRadius="6"
                                            VerticalAlignment="Center"
                                            Background="{x:Bind Vm.ActiveAccentPreviewBrush, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind Vm.ActiveAccentDisplayText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <controls:WrapPanel Margin="34,0,0,0" HorizontalSpacing="8" VerticalSpacing="8">
                                <Button
                                    locui:Localized.Content="跟随系统"
                                    Command="{x:Bind Vm.ResetAccentColorCommand}"
                                    VerticalAlignment="Center" />

                                <ItemsControl ItemsSource="{x:Bind Vm.AccentPresets, Mode=OneWay}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ThemeColorSwatchItem">
                                            <Button
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                CornerRadius="14"
                                                Background="{x:Bind SwatchBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                ToolTipService.ToolTip="{x:Bind ToolTipText}"
                                                Tag="{x:Bind Key}"
                                                Click="AccentSwatchBtn_Click">
                                                <FontIcon
                                                    Glyph="&#xE73E;"
                                                    FontSize="12"
                                                    Foreground="{x:Bind CheckBrush}"
                                                    Visibility="{x:Bind SelectedVisibility}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button locui:Localized.Content="自定义取色" VerticalAlignment="Center">
                                    <Button.Flyout>
                                        <Flyout x:Name="AccentPickerFlyout" Opening="AccentPickerFlyout_Opening">
                                            <StackPanel Spacing="12">
                                                <ColorPicker
                                                    x:Name="CustomAccentColorPicker"
                                                    IsColorSpectrumVisible="True"
                                                    IsColorSliderVisible="True"
                                                    IsColorChannelTextInputVisible="True"
                                                    IsHexInputVisible="True"
                                                    IsAlphaEnabled="False" />
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                    <Button locui:Localized.Content="恢复系统默认" Click="ResetAccentPicker_Click" />
                                                    <Button locui:Localized.Content="应用颜色" Style="{StaticResource AccentButtonStyle}" Click="ApplyCustomAccentPicker_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>

                    <controls:OmniSettingsCard
                        locui:Localized.Title="在首页中展示最近任务"
                        locui:Localized.Description="开启后将在首页底部显示最近或正在进行的下载任务（默认开启）"
                        Glyph="&#xE81C;">
                        <ToggleSwitch
                            locui:Localized.OffContent="关闭"
                            locui:Localized.OnContent="开启"
                            IsOn="{x:Bind Vm.ShowRecentTasksOnHome, Mode=TwoWay}" />
                    </controls:OmniSettingsCard>

                    <controls:OmniSettingsCard
                        locui:Localized.Title="关闭主窗口时"
                        locui:Localized.Description="选择点击关闭按钮时的默认行为，也可在弹窗中临时决定"
                        Glyph="&#xE8BB;">
                        <ComboBox x:Name="CloseBehaviorCombo" MinWidth="154" SelectionChanged="CloseBehaviorCombo_SelectionChanged">
                            <ComboBoxItem locui:Localized.Content="每次询问" Tag="ask" />
                            <ComboBoxItem locui:Localized.Content="最小化到托盘" Tag="tray" />
                            <ComboBoxItem locui:Localized.Content="直接关闭应用" Tag="exit" />
                        </ComboBox>
                    </controls:OmniSettingsCard>

                    <TextBlock locui:Localized.Text="功能设置" Style="{StaticResource GroupHeaderTextStyle}" />

                    <controls:OmniSettingsCard
                        locui:Localized.Title="下载与存储"
                        locui:Localized.Description="保存目录与并发任务数"
                        Glyph="&#xE8B7;"
                        IsClickEnabled="True"
                        Tag="downloads"
                        CardClicked="CategoryCard_Clicked" />

                    <controls:OmniSettingsCard
                        locui:Localized.Title="网络代理"
                        locui:Localized.Description="HTTP / HTTPS 与 SOCKS5 代理连接"
                        Glyph="&#xE968;"
                        IsClickEnabled="True"
                        Tag="network"
                        CardClicked="CategoryCard_Clicked" />

                    <controls:OmniSettingsCard
                        locui:Localized.Title="中转站"
                        locui:Localized.Description="添加、管理和删除第三方解析辅助站点"
                        Glyph="&#xE8A7;"
                        IsClickEnabled="True"
                        Tag="relay"
                        CardClicked="CategoryCard_Clicked" />

                    <controls:OmniSettingsCard
                        locui:Localized.Title="账号与 Cookie 会话"
                        locui:Localized.Description="浏览器一键登录、导入 Netscape Cookies 或哔哩哔哩 SESSDATA"
                        Glyph="&#xE77B;"
                        IsClickEnabled="True"
                        Tag="accounts"
                        CardClicked="CategoryCard_Clicked" />

                    <controls:OmniSettingsCard
                        locui:Localized.Title="组件管理"
                        locui:Localized.Description="管理核心与可选扩展组件启用状态，查看服务连接与自定义组件接入"
                        Glyph="&#xE896;"
                        IsClickEnabled="True"
                        Tag="engine"
                        CardClicked="CategoryCard_Clicked" />

                    <controls:OmniSettingsCard
                        locui:Localized.Title="关于"
                        locui:Localized.Description="应用形态、支持平台目录与数据兼容性说明"
                        Glyph="&#xE946;"
                        IsClickEnabled="True"
                        Tag="about"
                        CardClicked="CategoryCard_Clicked" />
                </StackPanel>

                <!-- 1. 二级：下载与存储 -->
                <StackPanel x:Name="PanelDownloads" Spacing="10" Visibility="Collapsed">
                    <controls:OmniSettingsCard
                        locui:Localized.Title="下载保存目录"
                        Description="{x:Bind Vm.DownloadDir, Mode=OneWay}"
                        Glyph="&#xE8B7;">
                        <Button locui:Localized.Content="打开目录" Command="{x:Bind Vm.OpenDownloadFolderCommand}" />
                    </controls:OmniSettingsCard>

                    <Border Style="{StaticResource OmniCardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBox
                                locui:Localized.Header="修改保存路径"
                                Text="{x:Bind Vm.DownloadDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                locui:Localized.PlaceholderText="输入保存路径..." />
                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <Button locui:Localized.Content="浏览文件夹..." Command="{x:Bind Vm.BrowseDownloadDirCommand}" />
                                <Button locui:Localized.Content="保存路径" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.SaveDownloadDirCommand}" />
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OmniCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <ToggleSwitch
                                locui:Localized.Header="分类保存目录"
                                locui:Localized.OffContent="按媒体类型分目录保存"
                                locui:Localized.OnContent="跟随默认目录"
                                IsOn="{x:Bind Vm.FollowDefaultDownloadDir, Mode=TwoWay}" />

                            <StackPanel
                                Spacing="10"
                                Visibility="{x:Bind Vm.UseCustomMediaDirs, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        locui:Localized.Header="视频保存目录"
                                        Text="{x:Bind Vm.VideoDownloadDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        locui:Localized.PlaceholderText="留空时回退至默认保存目录..." />
                                    <Button Grid.Column="1" locui:Localized.Content="浏览" VerticalAlignment="Bottom" Command="{x:Bind Vm.BrowseVideoDirCommand}" />
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        locui:Localized.Header="图片保存目录（含GIF）"
                                        Text="{x:Bind Vm.ImageDownloadDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        locui:Localized.PlaceholderText="留空时回退至默认保存目录..." />
                                    <Button Grid.Column="1" locui:Localized.Content="浏览" VerticalAlignment="Bottom" Command="{x:Bind Vm.BrowseImageDirCommand}" />
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        locui:Localized.Header="音频保存目录"
                                        Text="{x:Bind Vm.AudioDownloadDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        locui:Localized.PlaceholderText="留空时回退至默认保存目录..." />
                                    <Button Grid.Column="1" locui:Localized.Content="浏览" VerticalAlignment="Bottom" Command="{x:Bind Vm.BrowseAudioDirCommand}" />
                                </Grid>

                                <Button locui:Localized.Content="保存分类目录" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.SaveCategoryDirsCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <controls:OmniSettingsCard
                        locui:Localized.Title="最大同时下载任务数"
                        locui:Localized.Description="并发越高占用网络带宽越多（建议 2~5）"
                        Glyph="&#xE9D9;">
                        <NumberBox
                            x:Name="ConcurrentNumberBox"
                            Minimum="1"
                            Maximum="10"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind Vm.MaxConcurrentTasks, Mode=OneWay}"
                            ValueChanged="ConcurrentNumberBox_ValueChanged" />
                    </controls:OmniSettingsCard>


                </StackPanel>

                <!-- 2. 二级：网络代理 -->
                <StackPanel x:Name="PanelNetwork" Spacing="10" Visibility="Collapsed">
                    <Border Style="{StaticResource OmniCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock locui:Localized.Text="网络代理设置 (Proxy)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                locui:Localized.Text="支持 HTTP / HTTPS / SOCKS5 代理（如 http://127.0.0.1:7890 或 socks5://127.0.0.1:7891）；留空即直连网络。"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords" />

                            <TextBox
                                locui:Localized.Header="代理服务器地址"
                                Text="{x:Bind Vm.ProxyUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                locui:Localized.PlaceholderText="例如: http://127.0.0.1:7890" />

                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <Button locui:Localized.Content="保存并应用" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.SaveProxyCommand}" />
                                <Button
                                    locui:Localized.Content="清空代理"
                                    Visibility="{x:Bind Vm.HasProxy, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Command="{x:Bind Vm.ClearProxyCommand}" />
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3. 二级：中转站 -->
                <StackPanel x:Name="PanelRelay" Spacing="12" Visibility="Collapsed">
                    <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="8">
                        <TextBlock Text="{x:Bind Vm.RelaySectionTitle, Mode=OneWay}" Style="{StaticResource GroupHeaderTextStyle}" VerticalAlignment="Center" />
                        <Button
                            locui:Localized.Content="添加中转网站"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind Vm.RequestAddRelaySiteCommand}" />
                    </controls:WrapPanel>

                    <Border
                        Style="{StaticResource OmniCardBorderStyle}"
                        Visibility="{x:Bind Vm.HasRelaySites, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <TextBlock
                            locui:Localized.Text="暂未添加任何第三方解析中转站点，点击上方按钮即可添加常用站点（可自动读取网页标题）。"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="WrapWholeWords" />
                    </Border>

                    <ItemsRepeater ItemsSource="{x:Bind Vm.RelaySites, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:RelaySite">
                                <Border Style="{StaticResource OmniCardBorderStyle}">
                                    <StackPanel Spacing="8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{x:Bind Url}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                            <Button locui:Localized.Content="访问解析" Tag="{x:Bind}" Click="OpenRelayBtn_Click" />
                                            <Button locui:Localized.Content="移除" Tag="{x:Bind}" Click="DeleteRelayBtn_Click" />
                                        </controls:WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- 4. 二级：账号与 Cookie -->
                <StackPanel x:Name="PanelAccounts" Spacing="12" Visibility="Collapsed">
                    <InfoBar
                        IsOpen="{x:Bind Vm.ShowOutdatedBackendWarning, Mode=OneWay}"
                        IsClosable="False"
                        Severity="Warning"
                        locui:Localized.Title="检测到旧版后台服务"
                        Message="{x:Bind Vm.OutdatedBackendWarningText, Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button locui:Localized.Content="重连最新版核心" Command="{x:Bind Vm.ReconnectForLoginCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <Border Style="{StaticResource OmniCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="6">
                                <TextBlock locui:Localized.Text="平台 Cookie 会话隔离仓库 (Windows DPAPI 加密)" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="WrapWholeWords" />
                                <Border Style="{StaticResource OmniTagBorderStyle}">
                                    <TextBlock Text="{x:Bind Vm.SessionStatusBadge, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                            </controls:WrapPanel>

                            <ComboBox
                                x:Name="SessionPlatformCombo"
                                locui:Localized.Header="选择目标平台"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind Vm.SessionPlatformOptions, Mode=OneWay}"
                                DisplayMemberPath="DisplayName"
                                SelectionChanged="SessionPlatformCombo_SelectionChanged" />

                            <ToggleSwitch
                                x:Name="SessionDisableCookieToggle"
                                locui:Localized.Header="停用该平台 Cookie"
                                locui:Localized.OffContent="使用已导入会话"
                                locui:Localized.OnContent="强制匿名请求（仍保留原凭证）"
                                IsOn="{x:Bind Vm.IsSelectedPlatformCookieDisabled, Mode=OneWay}"
                                Toggled="SessionDisableCookieToggle_Toggled" />

                            <TextBlock Text="{x:Bind Vm.SessionPolicySummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />

                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <Button locui:Localized.Content="浏览器登录" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.OpenBrowserLoginCommand}" />
                                <Button locui:Localized.Content="保存会话并关闭" Command="{x:Bind Vm.SaveBrowserLoginCommand}" />
                                <Button locui:Localized.Content="导入 Netscape cookies.txt" Command="{x:Bind Vm.ImportSessionCookiesFileCommand}" />
                                <Button locui:Localized.Content="清除此平台会话" Command="{x:Bind Vm.ClearSelectedSessionCommand}" />
                            </controls:WrapPanel>

                            <TextBlock
                                Text="{x:Bind Vm.BrowserLoginStatusText, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>

                    <!-- 哔哩哔哩快速凭证区 -->
                    <Border Style="{StaticResource OmniCardBorderStyle}">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="4">
                                <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="4">
                                    <TextBlock locui:Localized.Text="登录哔哩哔哩 (Cookie / SESSDATA)" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="WrapWholeWords" />
                                    <Border Style="{StaticResource OmniTagBorderStyle}" Visibility="{x:Bind Vm.HasBilibiliSession, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <TextBlock locui:Localized.Text="凭据已保存，实际画质取决于账号权益与内容" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    </Border>
                                </controls:WrapPanel>
                                <TextBlock locui:Localized.Text="解锁 1080P60 / 4K 超清画质与大会员片源" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <TextBox
                                Text="{x:Bind Vm.BilibiliCookieInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                locui:Localized.PlaceholderText="粘贴 SESSDATA=xxx 或完整 Cookie 字符串" />

                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <Button locui:Localized.Content="内置网页一键登录" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.OpenBilibiliLoginWindowCommand}" />
                                <Button locui:Localized.Content="保存B站凭证" Command="{x:Bind Vm.SaveBilibiliCookieCommand}" />
                                <Button
                                    locui:Localized.Content="清空凭证"
                                    Visibility="{x:Bind Vm.HasBilibiliSession, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Command="{x:Bind Vm.ClearBilibiliCookieCommand}" />
                                <HyperlinkButton locui:Localized.Content="如何获取 SESSDATA？" Command="{x:Bind Vm.ShowBilibiliGuideCommand}" />
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 5. 二级：组件管理 -->
                <StackPanel x:Name="PanelEngine" Spacing="10" Visibility="Collapsed">
                    <Border Style="{StaticResource OmniCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock locui:Localized.Text="组件清单与扩展管理" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind Vm.ComponentSummaryText, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <controls:WrapPanel Grid.Column="1" HorizontalSpacing="8" VerticalSpacing="6" VerticalAlignment="Center">
                                    <Button locui:Localized.Content="添加自定义组件" Command="{x:Bind Vm.RequestAddCustomComponentCommand}" />
                                    <Button locui:Localized.Content="刷新探测" Command="{x:Bind Vm.CheckEngineDiagnosticsCommand}" />
                                </controls:WrapPanel>
                            </Grid>

                            <ItemsRepeater ItemsSource="{x:Bind Vm.ManagedComponents, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:ManagedComponentItem">
                                        <Border
                                            Padding="14,11"
                                            CornerRadius="6"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                                    <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="4">
                                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                                        <Border Style="{StaticResource OmniTagBorderStyle}" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind StatusBadge, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                        </Border>
                                                        <Border
                                                            Style="{StaticResource OmniTagBorderStyle}"
                                                            Padding="6,2"
                                                            VerticalAlignment="Center"
                                                            Visibility="{x:Bind IsRequired, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock locui:Localized.Text="必要" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Border>
                                                    </controls:WrapPanel>
                                                    <TextBlock
                                                        Text="{x:Bind DisplayDescription, Mode=OneWay}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Button
                                                        Padding="6,4"
                                                        locui:Localized.ToolTip="移除自定义组件"
                                                        Visibility="{x:Bind IsCustom, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                        Tag="{x:Bind Id, Mode=OneWay}"
                                                        Click="RemoveCustomComponentBtn_Click">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                    </Button>
                                                    <CheckBox
                                                        MinWidth="0"
                                                        Padding="0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        IsChecked="{x:Bind IsEnabled, Mode=OneWay}"
                                                        IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                                        Tag="{x:Bind Id, Mode=OneWay}"
                                                        Click="ComponentCheckBox_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <controls:OmniSettingsCard
                        locui:Localized.Title="开启网页服务"
                        locui:Localized.Description="开启后可从系统托盘拉起网页版并共享后台任务；关闭后退出应用将直接结束全部关联进程与组件。"
                        Glyph="&#xE774;">
                        <ToggleSwitch
                            locui:Localized.OffContent="关闭"
                            locui:Localized.OnContent="开启"
                            IsOn="{x:Bind Vm.EnableWebService, Mode=TwoWay}" />
                    </controls:OmniSettingsCard>
                    <controls:OmniSettingsCard
                        locui:Localized.Title="网页服务随 Windows 启动"
                        locui:Localized.Description="后台运行共享下载服务，开机不自动打开网页或客户端"
                        Glyph="&#xE7E8;">
                        <ToggleSwitch
                            x:Name="AutoStartToggle"
                            locui:Localized.OffContent="关闭"
                            locui:Localized.OnContent="开启"
                            IsOn="{x:Bind Vm.AutoStartWithWindows, Mode=OneWay}"
                            Toggled="AutoStartToggle_Toggled" />
                    </controls:OmniSettingsCard>
                    <controls:OmniSettingsCard
                        locui:Localized.Title="精简网页版"
                        locui:Localized.Description="下载、批量下载和任务进度与客户端共用同一服务。关闭客户端后网页下载继续运行。"
                        Glyph="&#xE774;"
                        Visibility="{x:Bind Vm.EnableWebService, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Button locui:Localized.Content="打开网页版" Command="{x:Bind Vm.OpenWebCompanionCommand}" />
                    </controls:OmniSettingsCard>
                    <controls:OmniSettingsCard
                        locui:Localized.Title="核心下载引擎运行状态"
                        Description="{x:Bind Vm.EngineStatusSummary, Mode=OneWay}"
                        Glyph="&#xE950;">
                        <Border Style="{StaticResource OmniTagBorderStyle}">
                            <TextBlock Text="{x:Bind Vm.EngineReadyBadge, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                    </controls:OmniSettingsCard>

                    <Border Style="{StaticResource OmniCardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock locui:Localized.Text="本地引擎连接配置" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBox
                                locui:Localized.Header="引擎服务地址"
                                Text="{x:Bind Vm.ServiceBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="http://127.0.0.1:58000" />
                            <ToggleSwitch
                                locui:Localized.Header="未检测到本地服务时自动伴随启动核心引擎"
                                locui:Localized.OffContent="仅连接已有服务"
                                locui:Localized.OnContent="自动伴随启动"
                                IsOn="{x:Bind Vm.AutoStartBackend, Mode=TwoWay}" />
                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <Button locui:Localized.Content="保存连接设置并重连" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.SaveBackendConnectionCommand}" />
                                <Button locui:Localized.Content="探测引擎组件状态" Command="{x:Bind Vm.CheckEngineDiagnosticsCommand}" />
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OmniCardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock locui:Localized.Text="应用与引擎更新检查" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind Vm.UpdateStatusText, Mode=OneWay}"
                                Visibility="{x:Bind Vm.UpdateStatusText, Mode=OneWay, Converter={StaticResource StrToVis}}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords" />
                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <Button locui:Localized.Content="检查应用更新" Command="{x:Bind Vm.CheckUpdateCommand}" />
                                <Button
                                    locui:Localized.Content="下载更新包"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind Vm.HasUpdateUrl, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Command="{x:Bind Vm.OpenUpdateDownloadUrlCommand}" />
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 6. 二级：关于 -->
                <StackPanel x:Name="PanelAbout" Spacing="12" Visibility="Collapsed">
                    <Border Style="{StaticResource OmniCardBorderStyle}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="OmniDownloader" Style="{StaticResource TitleTextBlockStyle}" />
                                <Border Style="{StaticResource OmniTagBorderStyle}" VerticalAlignment="Center">
                                    <TextBlock Text="v1.7.65 · WinUI 3" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind Vm.Loc.AboutNativeNote, Mode=OneWay}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>

                    <controls:OmniSettingsCard
                        locui:Localized.Title="支持平台与解析器目录 (yt-dlp)"
                        locui:Localized.Description="查看完整 1600+ 支持解析器与搜索过滤"
                        Glyph="&#xE774;"
                        IsClickEnabled="True"
                        CardClicked="AboutPlatformsCard_Clicked" />

                    <controls:OmniSettingsCard
                        locui:Localized.Title="运行形态"
                        locui:Localized.Description="Windows 原生桌面端 (WinUI 3 + Windows App SDK 1.6) · 连接本地 FastAPI 核心引擎"
                        Glyph="&#xE7F4;" />

                    <controls:OmniSettingsCard
                        locui:Localized.Title="首次使用引导"
                        locui:Localized.Description="重新打开引导面板配置主题色、保存目录与网页服务模式"
                        Glyph="&#xE9D5;">
                        <Button locui:Localized.Content="重新打开引导" Command="{x:Bind Vm.OpenOnboardingCommand}" />
                    </controls:OmniSettingsCard>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
