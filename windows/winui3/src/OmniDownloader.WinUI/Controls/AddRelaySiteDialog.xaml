<ContentDialog
    x:Class="OmniDownloader.WinUI.Controls.AddRelaySiteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="添加第三方解析中转网站"
    PrimaryButtonText="确认添加"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="AddRelaySiteDialog_PrimaryButtonClick">

    <StackPanel Spacing="12" MinWidth="260" HorizontalAlignment="Stretch">
        <TextBox
            x:Name="UrlBox"
            Header="网站地址"
            PlaceholderText="例如: https://example.com"
            LostFocus="UrlBox_LostFocus" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="NameBox"
                Grid.Column="0"
                Header="显示名称"
                PlaceholderText="留空可点击右侧自动识别网页标题" />
            <Button
                x:Name="FetchTitleBtn"
                Grid.Column="1"
                Content="获取标题"
                VerticalAlignment="Bottom"
                Click="FetchTitleBtn_Click" />
        </Grid>

        <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" />
    </StackPanel>
</ContentDialog>
