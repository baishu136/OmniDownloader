<ContentDialog
    x:Class="OmniDownloader.WinUI.Controls.FormatSelectorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OmniDownloader.WinUI.Controls"
    Title="选择下载格式与画质"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="560" HorizontalAlignment="Stretch" Padding="0,0,10,0">
        <StackPanel Spacing="14">
            <!-- 媒体摘要头 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="104"
                    Height="66"
                    CornerRadius="6"
                    VerticalAlignment="Top"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid>
                        <FontIcon Glyph="&#xE8B2;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Image x:Name="ThumbImage" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="MediaTitleText"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="WrapWholeWords" />

                    <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="4">
                        <Border Style="{StaticResource OmniTagBorderStyle}">
                            <TextBlock x:Name="SiteBadgeText" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                        <Border x:Name="GifBadge" Style="{StaticResource OmniTagBorderStyle}" Visibility="Collapsed">
                            <TextBlock Text="GIF" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                        <TextBlock
                            x:Name="DurationAuthorText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center"
                            TextWrapping="WrapWholeWords" />
                    </controls:WrapPanel>

                    <TextBlock
                        x:Name="BiliAccessText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="WrapWholeWords"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <!-- 画质说明与警告 -->
            <InfoBar x:Name="QualityWarningBar" IsOpen="False" IsClosable="False" Severity="Warning" />
            <TextBlock x:Name="QualityEvidenceText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" Visibility="Collapsed" />

            <!-- 合集与单集模式切换（多P时显示） -->
            <StackPanel x:Name="CollectionSection" Spacing="10" Visibility="Collapsed">
                <SelectorBar x:Name="ModeSelectorBar" SelectionChanged="ModeSelectorBar_SelectionChanged">
                    <SelectorBarItem x:Name="SingleModeItem" Text="下载单集" Tag="single" IsSelected="True" />
                    <SelectorBarItem x:Name="CollectionModeItem" Text="下载合集" Tag="collection" />
                </SelectorBar>

                <!-- 单集分P快速切换条 -->
                <StackPanel x:Name="SinglePartsPanel" Spacing="6">
                    <TextBlock x:Name="SinglePartsPrompt" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                        <StackPanel x:Name="SinglePartsChipsPanel" Orientation="Horizontal" Spacing="6" Padding="0,2" />
                    </ScrollViewer>
                </StackPanel>

                <!-- 合集多选面板 -->
                <StackPanel x:Name="CollectionChecklistPanel" Spacing="8" Visibility="Collapsed">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:WrapPanel Grid.Column="0" HorizontalSpacing="6" VerticalSpacing="6">
                            <Button Content="全选" Click="SelectAllEpisodes_Click" />
                            <Button Content="反选" Click="InvertEpisodes_Click" />
                            <Button Content="全不选" Click="SelectNoneEpisodes_Click" />
                        </controls:WrapPanel>
                        <TextBlock x:Name="EpisodesCountText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Grid>
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                        <ScrollViewer MaxHeight="168">
                            <StackPanel x:Name="EpisodesCheckListPanel" Spacing="4" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- 封面保存开关（分栏显式定义列宽，右侧永不裁切） -->
            <Grid x:Name="CoverActionPanel" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleSwitch
                    x:Name="SaveCoverToggle"
                    Grid.Column="0"
                    Header="下载时同时保存高清封面"
                    OffContent="否"
                    OnContent="是"
                    Toggled="SaveCoverToggle_Toggled" />
                <Button
                    x:Name="SaveCoverDirectBtn"
                    Grid.Column="1"
                    Content="单独保存封面"
                    VerticalAlignment="Center"
                    Click="SaveCoverDirectBtn_Click" />
            </Grid>

            <!-- 下载模式 4 选 1（流式自适应换行，绝不溢出裁字） -->
            <StackPanel Spacing="6">
                <TextBlock Text="下载模式" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                    <ToggleButton x:Name="TypeVideoAudioBtn" MinWidth="104" Padding="12,7" Content="音画合流" Tag="VIDEO_WITH_AUDIO" Click="TypeButton_Click" />
                    <ToggleButton x:Name="TypeVideoOnlyBtn" MinWidth="92" Padding="12,7" Content="纯画面" Tag="VIDEO_ONLY" Click="TypeButton_Click" />
                    <ToggleButton x:Name="TypeAudioOnlyBtn" MinWidth="104" Padding="12,7" Content="提取音频" Tag="AUDIO_ONLY" Click="TypeButton_Click" />
                    <ToggleButton x:Name="TypeGifBtn" MinWidth="96" Padding="12,7" Content="动图 GIF" Tag="GIF" Click="TypeButton_Click" />
                </controls:WrapPanel>
            </StackPanel>

            <!-- 视频分辨率与策略区 -->
            <StackPanel x:Name="VideoOptionsPanel" Spacing="10">
                <TextBlock x:Name="ResolutionHintText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="QualityPolicyCombo" Grid.Column="0" HorizontalAlignment="Stretch" Header="画质策略" SelectionChanged="QualityPolicyCombo_SelectionChanged">
                        <ComboBoxItem Content="最高源画质（含 4K/8K）" Tag="BEST_AVAILABLE" />
                        <ComboBoxItem Content="下方精确格式" Tag="EXACT_FORMAT" />
                        <ComboBoxItem Content="严格上限 4K" Tag="MAX_2160" />
                        <ComboBoxItem Content="指定 8K 档位" Tag="TARGET_4320" />
                        <ComboBoxItem Content="严格上限 1080p" Tag="MAX_1080" />
                        <ComboBoxItem Content="兼容优先 H.264" Tag="COMPATIBLE" />
                        <ComboBoxItem Content="最高 HDR 源" Tag="HDR" />
                        <ComboBoxItem Content="最高 SDR 源" Tag="SDR" />
                        <ComboBoxItem Content="至少 60fps" Tag="FPS60" />
                    </ComboBox>
                    <ComboBox x:Name="ContainerCombo" Grid.Column="1" MinWidth="116" Header="封装容器">
                        <ComboBoxItem Content="MP4 容器" Tag="mp4" />
                        <ComboBoxItem Content="自动容器" Tag="auto" />
                        <ComboBoxItem Content="MKV 容器" Tag="mkv" />
                        <ComboBoxItem Content="WebM 容器" Tag="webm" />
                    </ComboBox>
                </Grid>

                <CheckBox x:Name="AllowLowerQualityCheck" Content="当目标画质不可用时允许自动降级到较低画质" />

                <StackPanel x:Name="FormatListPanel" Spacing="4">
                    <TextBlock Text="可选视频流明细" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                        <ScrollViewer MaxHeight="160">
                            <RadioButtons x:Name="VideoFormatRadioButtons" SelectionChanged="VideoFormatRadioButtons_SelectionChanged" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- 音频格式区 -->
            <StackPanel x:Name="AudioOptionsPanel" Spacing="6" Visibility="Collapsed">
                <TextBlock Text="选择提取的音频格式" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <RadioButtons x:Name="AudioFormatRadioButtons" SelectionChanged="AudioFormatRadioButtons_SelectionChanged">
                    <RadioButton Content="MP3 · 高兼容性通用有损 (320kbps)" Tag="mp3" IsChecked="True" />
                    <RadioButton Content="M4A · AAC 高效保真流" Tag="m4a" />
                    <RadioButton Content="FLAC · 无损高保真音频" Tag="flac" />
                    <RadioButton Content="OPUS · 高压缩效率新锐音频" Tag="opus" />
                </RadioButtons>
            </StackPanel>

            <!-- GIF 说明区 -->
            <InfoBar
                x:Name="GifHintBar"
                IsOpen="True"
                IsClosable="False"
                Visibility="Collapsed"
                Severity="Informational"
                Title="动态图转换"
                Message="将使用本地 FFmpeg 自动生成调色板并导出高质量动图 GIF 文件。" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
