<ContentDialog
    x:Class="OmniDownloader.WinUI.Controls.OnboardingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:locui="using:OmniDownloader.WinUI.Helpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OmniDownloader.WinUI.Controls"
    xmlns:vm="using:OmniDownloader.WinUI.ViewModels"
    locui:Localized.Title="欢迎使用 OmniDownloader"
    locui:Localized.CloseButtonText="跳过设置"
    DefaultButton="Primary"
    PrimaryButtonClick="OnboardingDialog_PrimaryButtonClick"
    SecondaryButtonClick="OnboardingDialog_SecondaryButtonClick"
    CloseButtonClick="OnboardingDialog_CloseButtonClick">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="14" MinWidth="420" HorizontalAlignment="Stretch">
        <TextBlock
            locui:Localized.Text="快速完成初始偏好配置（后续均可随时在设置中更改）"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="WrapWholeWords" />

        <!-- 步骤分段导航指示 -->
        <SelectorBar x:Name="StepBar" SelectionChanged="StepBar_SelectionChanged">
            <SelectorBarItem x:Name="Step0Item" locui:Localized.Text="1. 主题色设置" Tag="0" />
            <SelectorBarItem x:Name="Step1Item" locui:Localized.Text="2. 保存目录" Tag="1" />
            <SelectorBarItem x:Name="Step2Item" locui:Localized.Text="3. 网页服务" Tag="2" />
        </SelectorBar>

        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Padding="0,2,4,2">
                <!-- 第 1 步：语言与主题颜色 -->
                <StackPanel x:Name="StepAppearancePanel" Spacing="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="LanguageCombo"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            locui:Localized.Header="界面语言"
                            SelectionChanged="LanguageCombo_SelectionChanged">
                            <ComboBoxItem locui:Localized.Content="简体中文" Tag="zh-CN" />
                            <ComboBoxItem locui:Localized.Content="繁體中文" Tag="zh-TW" />
                            <ComboBoxItem Content="English" Tag="en" />
                            <ComboBoxItem locui:Localized.Content="日本語" Tag="ja" />
                        </ComboBox>
                        <ComboBox
                            x:Name="ThemeCombo"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            locui:Localized.Header="外观模式"
                            SelectionChanged="ThemeCombo_SelectionChanged">
                            <ComboBoxItem locui:Localized.Content="跟随系统" Tag="auto" />
                            <ComboBoxItem locui:Localized.Content="浅色" Tag="light" />
                            <ComboBoxItem locui:Localized.Content="深色" Tag="dark" />
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource OmniCardBorderStyle}" Padding="14">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock locui:Localized.Text="主题颜色" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <Border
                                    Grid.Column="1"
                                    CornerRadius="999"
                                    Padding="10,4"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border
                                            x:Name="AccentPreviewDot"
                                            Width="12"
                                            Height="12"
                                            CornerRadius="6"
                                            VerticalAlignment="Center" />
                                        <TextBlock x:Name="AccentPreviewLabel" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <Button locui:Localized.Content="跟随系统" Click="SystemAccentBtn_Click" />
                                <ItemsControl x:Name="PresetSwatchesControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ThemeColorSwatchItem">
                                            <Button
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                CornerRadius="14"
                                                Background="{x:Bind SwatchBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                ToolTipService.ToolTip="{x:Bind ToolTipText}"
                                                Tag="{x:Bind Key}"
                                                Click="PresetSwatchBtn_Click">
                                                <FontIcon
                                                    Glyph="&#xE73E;"
                                                    FontSize="12"
                                                    Foreground="{x:Bind CheckBrush}"
                                                    Visibility="{x:Bind SelectedVisibility}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button locui:Localized.Content="自定义取色">
                                    <Button.Flyout>
                                        <Flyout x:Name="PickerFlyout" Opening="PickerFlyout_Opening">
                                            <StackPanel Spacing="10">
                                                <ColorPicker
                                                    x:Name="OnboardingColorPicker"
                                                    IsColorSpectrumVisible="True"
                                                    IsColorSliderVisible="True"
                                                    IsColorChannelTextInputVisible="True"
                                                    IsHexInputVisible="True"
                                                    IsAlphaEnabled="False" />
                                                <Button locui:Localized.Content="应用颜色" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="ApplyPickerColorBtn_Click" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 第 2 步：自定义下载目录 -->
                <StackPanel x:Name="StepDirsPanel" Spacing="12" Visibility="Collapsed">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="DefaultDirBox"
                            Grid.Column="0"
                            locui:Localized.Header="默认保存目录"
                            locui:Localized.PlaceholderText="输入或浏览默认下载目录..." />
                        <Button Grid.Column="1" locui:Localized.Content="浏览" VerticalAlignment="Bottom" Click="BrowseDefaultDir_Click" />
                    </Grid>

                    <Border Style="{StaticResource OmniCardBorderStyle}" Padding="14">
                        <StackPanel Spacing="10">
                            <ToggleSwitch
                                x:Name="FollowDefaultToggle"
                                locui:Localized.Header="分类保存目录"
                                locui:Localized.OnContent="跟随默认目录"
                                locui:Localized.OffContent="分别指定各类媒体保存目录"
                                Toggled="FollowDefaultToggle_Toggled" />

                            <StackPanel x:Name="CategoryDirsPanel" Spacing="10" Visibility="Collapsed">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="VideoDirBox"
                                        Grid.Column="0"
                                        locui:Localized.Header="视频保存目录"
                                        locui:Localized.PlaceholderText="留空时回退至默认保存目录..." />
                                    <Button Grid.Column="1" locui:Localized.Content="浏览" VerticalAlignment="Bottom" Click="BrowseVideoDir_Click" />
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="ImageDirBox"
                                        Grid.Column="0"
                                        locui:Localized.Header="图片保存目录（含GIF）"
                                        locui:Localized.PlaceholderText="留空时回退至默认保存目录..." />
                                    <Button Grid.Column="1" locui:Localized.Content="浏览" VerticalAlignment="Bottom" Click="BrowseImageDir_Click" />
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="AudioDirBox"
                                        Grid.Column="0"
                                        locui:Localized.Header="音频保存目录"
                                        locui:Localized.PlaceholderText="留空时回退至默认保存目录..." />
                                    <Button Grid.Column="1" locui:Localized.Content="浏览" VerticalAlignment="Bottom" Click="BrowseAudioDir_Click" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 第 3 步：是否开启网页服务 -->
                <StackPanel x:Name="StepWebServicePanel" Spacing="12" Visibility="Collapsed">
                    <Border Style="{StaticResource OmniCardBorderStyle}" Padding="16">
                        <StackPanel Spacing="12">
                            <ToggleSwitch
                                x:Name="WebServiceToggle"
                                locui:Localized.Header="是否开启网页服务"
                                locui:Localized.OnContent="开启网页服务"
                                locui:Localized.OffContent="不开启网页服务（退出应用直接结束全部组件）"
                                Toggled="WebServiceToggle_Toggled" />

                            <TextBlock
                                x:Name="WebServiceDetailText"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </StackPanel>
</ContentDialog>
