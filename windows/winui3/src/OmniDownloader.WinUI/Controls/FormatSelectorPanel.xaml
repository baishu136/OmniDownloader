<UserControl
    x:Class="OmniDownloader.WinUI.Controls.FormatSelectorPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:locui="using:OmniDownloader.WinUI.Helpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OmniDownloader.WinUI.Controls"
    HorizontalContentAlignment="Stretch"
    SizeChanged="FormatSelectorPanel_SizeChanged">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HdrGoldBorderBrush" Color="#FFD49B1A" />
                    <SolidColorBrush x:Key="HdrGoldFillBrush" Color="#14EAB308" />
                    <SolidColorBrush x:Key="HdrGoldSelectedFillBrush" Color="#22EAB308" />
                    <SolidColorBrush x:Key="HdrGoldBadgeBgBrush" Color="#28EAB308" />
                    <SolidColorBrush x:Key="HdrGoldBadgeFgBrush" Color="#FF9A6700" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="HdrGoldBorderBrush" Color="#FFF5C451" />
                    <SolidColorBrush x:Key="HdrGoldFillBrush" Color="#18F5C451" />
                    <SolidColorBrush x:Key="HdrGoldSelectedFillBrush" Color="#26F5C451" />
                    <SolidColorBrush x:Key="HdrGoldBadgeBgBrush" Color="#2DF5C451" />
                    <SolidColorBrush x:Key="HdrGoldBadgeFgBrush" Color="#FFFDE047" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

        <!-- 未选中规格方格样式：纯 ThemeResource 状态切换，杜绝深浅色切换后悬停残留高亮 -->
        <Style x:Key="FormatTileNormalStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="TileSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.BackgroundTransition>
                                <BrushTransition Duration="0:0:0.14" />
                            </Border.BackgroundTransition>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TileSurface" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TileSurface" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TileSurface" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileSurface" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 已选中规格方格样式：2px 强调色描边与柔和表面，内圈 Padding 抵消 1px 差值保证无抖动 -->
        <Style x:Key="FormatTileSelectedStyle" TargetType="Button" BasedOn="{StaticResource FormatTileNormalStyle}">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <!-- 含 HDR 参数方格样式（未选中）：外层一圈主题自适应金色轮廓 + 柔和金调底色 -->
        <Style x:Key="FormatTileHdrNormalStyle" TargetType="Button" BasedOn="{StaticResource FormatTileNormalStyle}">
            <Setter Property="Background" Value="{ThemeResource HdrGoldFillBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource HdrGoldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="10.5,8.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="OuterHdrRing"
                            BorderBrush="{ThemeResource HdrGoldBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="9"
                            Padding="1">
                            <Border
                                x:Name="TileSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                                <Border.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.14" />
                                </Border.BackgroundTransition>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TileSurface" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource HdrGoldSelectedFillBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TileSurface" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="OuterHdrRing" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Margin="{TemplateBinding Padding}" />
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 含 HDR 参数方格样式（已选中）：保留外圈高亮金色轮廓，内层保留选中强调描边 -->
        <Style x:Key="FormatTileHdrSelectedStyle" TargetType="Button" BasedOn="{StaticResource FormatTileHdrNormalStyle}">
            <Setter Property="Background" Value="{ThemeResource HdrGoldSelectedFillBrush}" />
            <Setter Property="Padding" Value="9.5,7.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="OuterHdrRing"
                            BorderBrush="{ThemeResource HdrGoldBorderBrush}"
                            BorderThickness="2"
                            CornerRadius="10"
                            Padding="1">
                            <Border
                                x:Name="TileSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="1.5"
                                CornerRadius="7">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TileSurface" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource HdrGoldSelectedFillBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TileSurface" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="OuterHdrRing" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Margin="{TemplateBinding Padding}" />
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 纯 ThemeResource 文字/图标/边框样式，随页面深浅色实时切换 -->
        <Style x:Key="TilePrimaryTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TileSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="TileCheckIconStyle" TargetType="FontIcon">
            <Setter Property="Glyph" Value="&#xE73E;" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TileFallbackBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="14">
        <!-- 1. 媒体摘要头 + 右侧封面保存选项区 -->
        <Grid x:Name="HeaderGrid" ColumnSpacing="12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Row="0"
                Grid.Column="0"
                Width="104"
                Height="66"
                CornerRadius="6"
                VerticalAlignment="Top"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <Grid>
                    <FontIcon Glyph="&#xE8B2;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Image x:Name="ThumbImage" Stretch="UniformToFill" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock
                    x:Name="MediaTitleText"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="WrapWholeWords" />

                <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="4">
                    <Border Style="{StaticResource OmniTagBorderStyle}">
                        <TextBlock x:Name="SiteBadgeText" Style="{StaticResource CaptionTextBlockStyle}" />
                    </Border>
                    <Border x:Name="GifBadge" Style="{StaticResource OmniTagBorderStyle}" Visibility="Collapsed">
                        <TextBlock Text="GIF" Style="{StaticResource CaptionTextBlockStyle}" />
                    </Border>
                    <TextBlock
                        x:Name="DurationAuthorText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                </controls:WrapPanel>

                <TextBlock
                    x:Name="BiliAccessText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="WrapWholeWords"
                    Visibility="Collapsed" />
            </StackPanel>

            <!-- 封面保存选项移至标题头右侧（窄窗时自动折入第二行） -->
            <StackPanel
                x:Name="CoverActionPanel"
                Grid.Row="0"
                Grid.Column="2"
                Spacing="4"
                VerticalAlignment="Center"
                HorizontalAlignment="Right">
                <CheckBox
                    x:Name="SaveCoverCheck"
                    locui:Localized.Content="同时保存封面"
                    MinWidth="0"
                    MinHeight="28"
                    Padding="6,0,0,0"
                    Checked="SaveCoverCheck_Changed"
                    Unchecked="SaveCoverCheck_Changed" />
                <Button
                    x:Name="SaveCoverDirectBtn"
                    locui:Localized.Content="单独保存封面"
                    HorizontalAlignment="Stretch"
                    Padding="10,5"
                    Click="SaveCoverDirectBtn_Click" />
            </StackPanel>
        </Grid>

        <!-- 画质说明与警告 -->
        <InfoBar x:Name="QualityWarningBar" IsOpen="False" IsClosable="False" Severity="Warning" />
        <TextBlock x:Name="QualityEvidenceText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" Visibility="Collapsed" />

        <!-- 2. 合集与单集模式切换（多P时显示） -->
        <StackPanel x:Name="CollectionSection" Spacing="8" Visibility="Collapsed">
            <SelectorBar x:Name="ModeSelectorBar" SelectionChanged="ModeSelectorBar_SelectionChanged">
                <SelectorBarItem x:Name="SingleModeItem" locui:Localized.Text="下载单集" Tag="single" IsSelected="True" />
                <SelectorBarItem x:Name="CollectionModeItem" locui:Localized.Text="下载合集" Tag="collection" />
            </SelectorBar>

            <!-- 单集分P快速切换条 -->
            <StackPanel x:Name="SinglePartsPanel" Spacing="6">
                <TextBlock x:Name="SinglePartsPrompt" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                    <StackPanel x:Name="SinglePartsChipsPanel" Orientation="Horizontal" Spacing="6" Padding="0,2" />
                </ScrollViewer>
            </StackPanel>

            <!-- 合集多选面板 -->
            <StackPanel x:Name="CollectionChecklistPanel" Spacing="8" Visibility="Collapsed">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:WrapPanel Grid.Column="0" HorizontalSpacing="6" VerticalSpacing="6">
                        <Button locui:Localized.Content="全选" Click="SelectAllEpisodes_Click" />
                        <Button locui:Localized.Content="反选" Click="InvertEpisodes_Click" />
                        <Button locui:Localized.Content="全不选" Click="SelectNoneEpisodes_Click" />
                    </controls:WrapPanel>
                    <TextBlock x:Name="EpisodesCountText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Grid>
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                    <ScrollViewer MaxHeight="168">
                        <StackPanel x:Name="EpisodesCheckListPanel" Spacing="4" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- 3. 下载模式 / 封装容器 双栏并排下拉行（最省高度，窄窗自动分行） -->
        <Grid x:Name="ModePolicyGrid" ColumnSpacing="10" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ComboBox
                x:Name="DownloadTypeCombo"
                Grid.Row="0"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                locui:Localized.Header="下载模式"
                SelectionChanged="DownloadTypeCombo_SelectionChanged">
                <ComboBoxItem locui:Localized.Content="视频" Tag="VIDEO_WITH_AUDIO" />
                <ComboBoxItem locui:Localized.Content="纯画面" Tag="VIDEO_ONLY" />
                <ComboBoxItem locui:Localized.Content="音频" Tag="AUDIO_ONLY" />
                <ComboBoxItem Content="GIF" Tag="GIF" />
            </ComboBox>

            <ComboBox
                x:Name="ContainerCombo"
                Grid.Row="0"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                locui:Localized.Header="封装容器">
                <ComboBoxItem locui:Localized.Content="MP4 容器" Tag="mp4" />
                <ComboBoxItem locui:Localized.Content="自动容器" Tag="auto" />
                <ComboBoxItem locui:Localized.Content="MKV 容器" Tag="mkv" />
                <ComboBoxItem locui:Localized.Content="WebM 容器" Tag="webm" />
            </ComboBox>
        </Grid>

        <!-- 4. 视频流选项与多列规格方格卡片 -->
        <StackPanel x:Name="VideoOptionsPanel" Spacing="8">
            <TextBlock
                x:Name="ResolutionHintText"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="WrapWholeWords" />

            <StackPanel x:Name="FormatListPanel" Spacing="6">
                <TextBlock locui:Localized.Text="可选视频流（点击选择清晰度、格式与体积）" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <controls:WrapPanel x:Name="VideoFormatGrid" HorizontalSpacing="8" VerticalSpacing="8" />
            </StackPanel>
        </StackPanel>

        <!-- 5. 音频格式区 -->
        <StackPanel x:Name="AudioOptionsPanel" Spacing="6" Visibility="Collapsed">
            <TextBlock locui:Localized.Text="选择提取的音频格式" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <RadioButtons x:Name="AudioFormatRadioButtons" SelectionChanged="AudioFormatRadioButtons_SelectionChanged">
                <RadioButton locui:Localized.Content="MP3 · 高兼容性通用有损 (320kbps)" Tag="mp3" IsChecked="True" />
                <RadioButton locui:Localized.Content="M4A · AAC 高效保真流" Tag="m4a" />
                <RadioButton locui:Localized.Content="FLAC · 无损高保真音频" Tag="flac" />
                <RadioButton locui:Localized.Content="OPUS · 高压缩效率新锐音频" Tag="opus" />
            </RadioButtons>
        </StackPanel>

        <!-- 6. GIF 说明区 -->
        <InfoBar
            x:Name="GifHintBar"
            IsOpen="True"
            IsClosable="False"
            Visibility="Collapsed"
            Severity="Informational"
            locui:Localized.Title="动态图转换"
            locui:Localized.Message="将使用本地 FFmpeg 自动生成调色板并导出高质量动图 GIF 文件。" />

        <!-- 7. 提交动作区 -->
        <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="8">
            <Button x:Name="PrimaryAction" Style="{StaticResource AccentButtonStyle}" Click="PrimaryAction_Click" />
            <Button x:Name="SecondaryAction" Visibility="Collapsed" Click="SecondaryAction_Click" />
        </controls:WrapPanel>
    </StackPanel>
</UserControl>
