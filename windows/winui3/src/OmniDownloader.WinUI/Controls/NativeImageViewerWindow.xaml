<Window
    x:Class="OmniDownloader.WinUI.Controls.NativeImageViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OmniDownloader · 图片查看">

    <Grid x:Name="RootGrid" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Padding="14,0,148,0" ColumnSpacing="8" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xEB9F;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock
                x:Name="WindowTitleText"
                Grid.Column="1"
                Text="图片查看"
                Style="{StaticResource CaptionTextBlockStyle}"
                FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis"
                VerticalAlignment="Center" />
        </Grid>

        <!-- 控制工具栏（支持窄窗口自动折行） -->
        <Grid
            Grid.Row="1"
            Padding="14,8"
            ColumnSpacing="10"
            RowSpacing="8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="EntryTitleText" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="MetaText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button ToolTipService.ToolTip="缩小 (-)" Click="ZoomOutBtn_Click" Padding="8,5">
                    <FontIcon Glyph="&#xE71F;" FontSize="14" />
                </Button>
                <Button x:Name="ZoomBadgeBtn" Content="适应" ToolTipService.ToolTip="点击重置为适应窗口 (0)" Click="FitZoomBtn_Click" Padding="10,5" />
                <Button Content="1:1" ToolTipService.ToolTip="原始像素大小 (1)" Click="ActualZoomBtn_Click" Padding="9,5" />
                <Button ToolTipService.ToolTip="放大 (+)" Click="ZoomInBtn_Click" Padding="8,5">
                    <FontIcon Glyph="&#xE8A3;" FontSize="14" />
                </Button>

                <Button
                    x:Name="DownloadSingleBtn"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="保存此原图"
                    Visibility="Collapsed"
                    Click="DownloadSingleBtn_Click" />

                <Button
                    x:Name="LocateBtn"
                    ToolTipService.ToolTip="在电脑中定位文件"
                    Visibility="Collapsed"
                    Click="LocateBtn_Click"
                    Padding="9,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                        <TextBlock Text="定位" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="OpenExternalBtn"
                    ToolTipService.ToolTip="用系统默认看图程序打开"
                    Visibility="Collapsed"
                    Click="OpenExternalBtn_Click"
                    Padding="9,5">
                    <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 无级缩放看图画布 -->
        <Border Grid.Row="2" Background="#FF0E1015">
            <Grid>
                <ScrollViewer
                    x:Name="ZoomScroller"
                    ZoomMode="Enabled"
                    MinZoomFactor="0.1"
                    MaxZoomFactor="8.0"
                    HorizontalScrollMode="Auto"
                    VerticalScrollMode="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    IsScrollInertiaEnabled="True"
                    SizeChanged="ZoomScroller_SizeChanged"
                    ViewChanged="ZoomScroller_ViewChanged"
                    DoubleTapped="ZoomScroller_DoubleTapped">
                    <Image
                        x:Name="PreviewImage"
                        Stretch="None"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </ScrollViewer>

                <ProgressRing
                    x:Name="LoadingRing"
                    IsActive="True"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

                <StackPanel
                    x:Name="FailedPanel"
                    Visibility="Collapsed"
                    Spacing="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <FontIcon Glyph="&#xEA39;" FontSize="36" Foreground="#FFB0B5C0" HorizontalAlignment="Center" />
                    <TextBlock Text="预览暂不可用，可尝试用系统默认程序打开或直接保存原图" Foreground="#FFD0D4DE" HorizontalAlignment="Center" />
                    <Button x:Name="FallbackOpenBtn" Content="用系统看图打开" HorizontalAlignment="Center" Visibility="Collapsed" Click="OpenExternalBtn_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部导航条 -->
        <Grid
            Grid.Row="3"
            Padding="14,8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Button x:Name="PrevBtn" AutomationProperties.Name="上一张" HorizontalAlignment="Left" Click="PrevBtn_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                    <TextBlock Text="上一张" />
                </StackPanel>
            </Button>

            <TextBlock
                x:Name="FooterHintText"
                Text="←/→ 切换 · 双击/滚轮缩放 · Esc 关闭"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Button x:Name="NextBtn" AutomationProperties.Name="下一张" HorizontalAlignment="Right" Click="NextBtn_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="下一张" />
                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
